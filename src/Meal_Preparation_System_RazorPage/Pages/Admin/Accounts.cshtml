@page
@model Meal_Preparation_System_RazorPage.Pages.Admin.AccountsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Staff Accounts";
}

<a asp-page="/Admin/Dashboard" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>

<div class="page-header">
    <h2><i class="bi bi-people me-2" style="color: var(--clr-primary);"></i>Staff Accounts</h2>
    <p class="mb-0">Create and manage Manager and DeliveryMan accounts</p>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card-modern p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-person-plus me-2" style="color: var(--clr-success);"></i>Create Staff Account</h5>
            <form method="post" asp-page-handler="Create">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <input asp-for="NewFullName" class="form-control form-control-modern" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="NewEmail" type="email" class="form-control form-control-modern" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control form-control-modern" required />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Role</label>
                    <select asp-for="NewRole" class="form-select form-control-modern">
                        <option value="Manager">Manager</option>
                        <option value="DeliveryMan">Delivery Man</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary-custom w-100" style="background: var(--clr-success);">
                    <i class="bi bi-plus-lg me-1"></i> Create Account
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        @if (!Model.StaffAccounts.Any())
        {
            <div class="empty-state">
                <i class="bi bi-people display-1 text-muted"></i>
                <h5 class="mt-3">No Staff Accounts</h5>
                <p>Create a Manager or DeliveryMan account using the form.</p>
            </div>
        }
        else
        {
            <div class="card-modern">
                <div class="table-responsive">
                    <table class="table table-modern mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model.StaffAccounts)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <i class="bi bi-person-circle me-1" style="color: var(--clr-primary);"></i>
                                        @account.FullName
                                    </td>
                                    <td>@account.Email</td>
                                    <td>
                                        <span class="badge @(account.Role == "Manager" ? "badge-soft-primary" : "badge-soft-warning")">
                                            @account.Role
                                        </span>
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="Delete"
                                              data-confirm='{"title":"Delete Account?","message":"This staff account will be permanently removed.","icon":"bi-trash","confirmText":"Delete"}'>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="accountId" value="@account.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
