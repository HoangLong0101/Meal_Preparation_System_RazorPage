@page
@model Meal_Preparation_System_RazorPage.Pages.Account.RegisterModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
}

<style>
    .register-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
    }
    .register-header {
        background: linear-gradient(135deg, #ff6b35, #ff8c5a);
        padding: 40px 32px;
        text-align: center;
        color: white;
    }
    .register-header i {
        font-size: 48px;
        margin-bottom: 12px;
        display: block;
    }
    .register-header h3 {
        font-weight: 700;
        margin-bottom: 4px;
    }
    .register-header p {
        opacity: 0.9;
        font-size: 14px;
        margin: 0;
    }
    .register-body {
        padding: 32px;
    }
    .form-label-modern {
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 8px;
    }
    .input-group-modern .input-group-text {
        background: #fff5f0;
        border: 2px solid #f0f0f0;
        border-right: none;
        color: #ff6b35;
    }
    .input-group-modern .form-control {
        border: 2px solid #f0f0f0;
        border-left: none;
        padding: 12px 16px;
    }
    .input-group-modern .form-control:focus {
        border-color: #ff6b35;
        box-shadow: none;
    }
    .input-group-modern:focus-within .input-group-text {
        border-color: #ff6b35;
    }
    .btn-register {
        background: linear-gradient(135deg, #ff6b35, #ff8c5a);
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-register:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);
        color: white;
    }
    .login-link {
        color: #ff6b35;
        font-weight: 600;
        text-decoration: none;
    }
    .login-link:hover {
        color: #ff5722;
        text-decoration: underline;
    }
    .benefit-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }
    .benefit-item:last-child {
        border-bottom: none;
    }
    .benefit-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        flex-shrink: 0;
    }
    .benefit-icon.orange { background: #fff5f0; color: #ff6b35; }
    .benefit-icon.green { background: #e8f5e9; color: #43a047; }
    .benefit-icon.blue { background: #e3f2fd; color: #1e88e5; }
</style>

<div class="row justify-content-center" style="margin-top: 3rem; margin-bottom: 4rem;">
    <div class="col-lg-10">
        <div class="row g-4">
            <!-- Benefits Column -->
            <div class="col-lg-5 d-none d-lg-block">
                <h2 style="font-weight: 700; margin-bottom: 8px;">Join Meal AI</h2>
                <p class="text-muted mb-4">Start your journey to healthier, smarter meals today</p>

                <div class="benefit-item">
                    <div class="benefit-icon orange">
                        <i class="bi bi-stars"></i>
                    </div>
                    <div>
                        <strong>AI-Powered Suggestions</strong>
                        <div class="text-muted" style="font-size: 13px;">Get meal ideas tailored to your health and preferences</div>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon green">
                        <i class="bi bi-heart-pulse"></i>
                    </div>
                    <div>
                        <strong>Health Tracking</strong>
                        <div class="text-muted" style="font-size: 13px;">Monitor nutrition and achieve your dietary goals</div>
                    </div>
                </div>
                <div class="benefit-item">
                    <div class="benefit-icon blue">
                        <i class="bi bi-calendar-week"></i>
                    </div>
                    <div>
                        <strong>Weekly Planning</strong>
                        <div class="text-muted" style="font-size: 13px;">Plan your meals for the entire week effortlessly</div>
                    </div>
                </div>
            </div>

            <!-- Register Form Column -->
            <div class="col-lg-7">
                <div class="register-card">
                    <div class="register-header">
                        <i class="bi bi-person-plus"></i>
                        <h3>Create Account</h3>
                        <p>Join thousands of happy Meal AI users</p>
                    </div>
                    <div class="register-body">
                        <form method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label-modern">Full Name</label>
                                <div class="input-group input-group-modern">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="Input.FullName" class="form-control" placeholder="John Doe" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label-modern">Email</label>
                                <div class="input-group input-group-modern">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Input.Email" class="form-control" type="email" placeholder="you@example.com" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label-modern">Password</label>
                                <div class="input-group input-group-modern">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Input.Password" class="form-control" type="password" placeholder="••••••••" required />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label-modern">Confirm Password</label>
                                <div class="input-group input-group-modern">
                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" required />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-register w-100">
                                <i class="bi bi-rocket-takeoff me-2"></i>Create Account
                            </button>
                        </form>

                        <div class="text-center mt-4">
                            <span class="text-muted">Already have an account?</span>
                            <a asp-page="/Account/Login" class="login-link">Login here</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
