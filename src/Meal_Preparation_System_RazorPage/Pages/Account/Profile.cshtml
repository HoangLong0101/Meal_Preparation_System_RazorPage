@page
@model Meal_Preparation_System_RazorPage.Pages.Account.ProfileModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Profile";
}

<div class="page-header">
    <h2><i class="bi bi-person-gear me-2" style="color: var(--clr-primary);"></i>My Profile</h2>
    <p class="mb-0">Manage your health information so AI can generate personalized meals</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card-modern p-4">
            <h5 class="fw-bold mb-1"><i class="bi bi-heart-pulse me-2" style="color: var(--clr-danger);"></i>Health Profile</h5>
            <p class="text-muted small mb-4">This information helps AI create meals tailored to your needs</p>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Profile.Id" />
                <input type="hidden" asp-for="Profile.AccountId" />

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Age</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                            <input asp-for="Profile.Age" class="form-control" type="number" min="1" max="150" required />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Weight (kg)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-speedometer"></i></span>
                            <input asp-for="Profile.Weight" class="form-control" type="number" step="0.1" min="1" required />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Height (cm)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-rulers"></i></span>
                            <input asp-for="Profile.Height" class="form-control" type="number" step="0.1" min="1" required />
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Gender</label>
                        <select asp-for="Profile.Gender" class="form-select form-control-modern" required>
                            <option value="">Select gender...</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Daily Calorie Goal</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-fire"></i></span>
                            <input asp-for="Profile.CalorieGoal" class="form-control" type="number" min="500" max="10000" placeholder="e.g. 2000" />
                            <span class="input-group-text">kcal</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Dietary Restrictions</label>
                    <select asp-for="Profile.DietaryRestrictions" class="form-select form-control-modern">
                        <option value="">None</option>
                        <option value="vegetarian">Vegetarian</option>
                        <option value="vegan">Vegan</option>
                        <option value="keto">Keto</option>
                        <option value="low-carb">Low Carb</option>
                        <option value="high-protein">High Protein</option>
                        <option value="gluten-free">Gluten Free</option>
                        <option value="dairy-free">Dairy Free</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Food Preferences</label>
                    <textarea asp-for="Profile.FoodPreferences" class="form-control form-control-modern" rows="3"
                              placeholder="e.g. I love chicken and spicy food, prefer Asian cuisine, dislike mushrooms..."></textarea>
                    <small class="text-muted">Tell the AI what you like and dislike — be as specific as you want</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Health Notes</label>
                    <textarea asp-for="Profile.HealthNotes" class="form-control form-control-modern" rows="2"
                              placeholder="e.g. Diabetes, high blood pressure, recovering from surgery..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary-custom">
                    <i class="bi bi-check-lg me-1"></i> @(Model.IsNewProfile ? "Create Profile" : "Update Profile")
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card-modern p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-shield-exclamation me-2" style="color: var(--clr-warning);"></i>Allergies</h5>
            <p class="text-muted small mb-3">AI will avoid ingredients related to your allergies</p>

            @if (Model.Profile.Allergies.Any())
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var allergy in Model.Profile.Allergies)
                    {
                        var allergyObj = Model.AvailableAllergies.FirstOrDefault(a => a.AllergyName == allergy);
                        <div class="d-flex align-items-center gap-1 px-3 py-2 rounded-3" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
                            <span class="fw-semibold small" style="color: #b45309;">@allergy</span>
                            @if (allergyObj != null)
                            {
                                <form method="post" asp-page-handler="RemoveAllergy" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="allergyId" value="@allergyObj.Id" />
                                    <button type="submit" class="btn btn-link p-0 ms-1" style="color: #b45309; font-size: 0.8rem;">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-3">No allergies added yet.</p>
            }

            @if (!Model.IsNewProfile)
            {
                <form method="post" asp-page-handler="AddAllergy">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <select asp-for="SelectedAllergyId" class="form-select form-control-modern form-select-sm">
                            <option value="">Add allergy...</option>
                            @foreach (var a in Model.AvailableAllergies.Where(a => !Model.Profile.Allergies.Contains(a.AllergyName)))
                            {
                                <option value="@a.Id">@a.AllergyName</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-warning btn-sm">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted small fst-italic">Save your profile first to manage allergies.</p>
            }
        </div>

        @if (!Model.IsNewProfile)
        {
            <div class="card-modern p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart me-2" style="color: var(--clr-primary);"></i>BMI Summary</h5>
                <div class="text-center">
                    <div class="stat-value" style="color: @Model.BmiColor; font-size: 2rem;">@Math.Round(Model.Bmi, 1)</div>
                    <div class="stat-label">@Model.BmiCategory</div>
                </div>
                <hr />
                <div class="row text-center g-2">
                    <div class="col-4">
                        <div class="stat-label">Weight</div>
                        <div class="fw-bold">@Model.Profile.Weight kg</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-label">Height</div>
                        <div class="fw-bold">@Model.Profile.Height cm</div>
                    </div>
                    <div class="col-4">
                        <div class="stat-label">Goal</div>
                        <div class="fw-bold">@(Model.Profile.CalorieGoal?.ToString() ?? "—") kcal</div>
                    </div>
                </div>
            </div>
        }

        <div class="card-modern p-4 mt-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-people me-2" style="color: var(--clr-primary);"></i>Family Members</h5>
            <p class="text-muted small mb-3">AI will adjust portion sizes based on how many people you're cooking for</p>

            @if (Model.FamilyMembers.Any())
            {
                <div class="d-flex flex-column gap-2 mb-3">
                    @foreach (var member in Model.FamilyMembers)
                    {
                        <div class="d-flex align-items-center justify-content-between px-3 py-2 rounded-3" style="background: var(--clr-bg); border: 1px solid var(--clr-border);">
                            <div>
                                <span class="fw-semibold">@member.Name</span>
                                @if (member.Age.HasValue)
                                {
                                    <span class="text-muted small ms-1">(@member.Age yrs)</span>
                                }
                                @if (!string.IsNullOrEmpty(member.Notes))
                                {
                                    <small class="text-muted d-block">@member.Notes</small>
                                }
                            </div>
                            <form method="post" asp-page-handler="RemoveMember" data-confirm='{"title":"Remove Member?","message":"Remove this family member from your profile.","icon":"bi-person-dash","confirmText":"Remove"}'>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="memberId" value="@member.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-3">No family members added. You'll cook for yourself only.</p>
            }

            <form method="post" asp-page-handler="AddMember">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col">
                        <input asp-for="NewMemberName" class="form-control form-control-sm form-control-modern" placeholder="Name" required />
                    </div>
                    <div class="col-3">
                        <input asp-for="NewMemberAge" class="form-control form-control-sm form-control-modern" type="number" min="1" max="150" placeholder="Age" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </div>
                <input asp-for="NewMemberNotes" class="form-control form-control-sm form-control-modern mt-2" placeholder="Notes (e.g. picky eater, allergic to nuts)" />
            </form>
        </div>
    </div>
</div>
