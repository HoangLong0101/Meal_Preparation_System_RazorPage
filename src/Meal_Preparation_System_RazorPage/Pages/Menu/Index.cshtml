@page
@model Meal_Preparation_System_RazorPage.Pages.Menu.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Today's Menu";
}

<style>
    .menu-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 40px 0;
        margin: -24px -12px 30px -12px;
        border-radius: 0 0 24px 24px;
    }
    .today-banner {
        background: linear-gradient(135deg, #ff6b35, #ff8c5a);
        border-radius: 16px 16px 0 0;
        padding: 20px 24px;
        color: white;
    }
    .menu-meal-card {
        background: white;
        border: 1px solid #f0f0f0;
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }
    .menu-meal-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .menu-meal-card.sold-out {
        opacity: 0.5;
    }
    .price-tag {
        color: #ff6b35;
        font-size: 1.1rem;
        font-weight: 700;
    }
    .btn-order {
        background: linear-gradient(135deg, #ff6b35, #ff8c5a);
        border: none;
        padding: 10px;
        border-radius: 10px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-order:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);
        color: white;
    }
    .week-card {
        background: white;
        border: 1px solid #f0f0f0;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 16px;
    }
    .week-card-header {
        background: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        padding: 16px 24px;
    }
</style>

<div class="menu-header">
    <div class="container">
        <h1 style="font-size: 2rem; font-weight: 700;"><i class="bi bi-cup-hot me-2" style="color: #ff6b35;"></i>Daily Menu</h1>
        <p style="color: #888;">Fresh meals available for order</p>
    </div>
</div>

@if (Model.TodayMenu != null)
{
    <div class="card-modern mb-4" style="overflow: hidden;">
        <div class="today-banner d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 fw-bold"><i class="bi bi-star-fill me-2"></i>Today — @Model.TodayMenu.MenuDate.ToString("dddd, MMM dd yyyy")</h5>
            </div>
            <span class="badge bg-white text-dark">@Model.TodayMenu.Status</span>
        </div>
        <div class="p-4">
            @if (Model.TodayMenu.MenuMeals.Any())
            {
                <div class="row g-3" id="today-menu-meals">
                    @foreach (var menuMeal in Model.TodayMenu.MenuMeals)
                    {
                        <div class="col-md-4" data-meal-name="@menuMeal.RecipeName">
                            <div class="menu-meal-card h-100 @(menuMeal.IsSoldOut ? "sold-out" : "")" data-menu-card="@menuMeal.RecipeName">
                                <div class="card-body p-4">
                                    <h6 class="fw-bold">@menuMeal.RecipeName</h6>
                                    <div class="d-flex gap-1 flex-wrap mb-2">
                                        <span class="badge badge-soft-primary">@Math.Round(menuMeal.Recipe.TotalCalories, 0) kcal</span>
                                        <span class="badge badge-soft-success">P: @Math.Round(menuMeal.Recipe.ProteinG, 1)g</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="price-tag">@menuMeal.Price.ToString("N0") ₫</span>
                                        @if (menuMeal.IsSoldOut)
                                        {
                                            <span class="badge badge-soft-danger" data-stock-badge>Sold Out</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small" data-stock-badge><i class="bi bi-box me-1"></i><span data-stock-count>@menuMeal.AvailableQuantity</span> left</span>
                                        }
                                    </div>
                                </div>
                                @if (!menuMeal.IsSoldOut && HttpContext.Session.GetString("AccountId") != null)
                                {
                                    <div class="card-footer p-3" style="background: #fafafa; border-top: 1px solid #f0f0f0;" data-order-footer>
                                        <a asp-page="/Orders/Create" asp-route-menuMealId="@menuMeal.Id" class="btn btn-order btn-sm w-100">
                                            <i class="bi bi-bag-plus me-1"></i>Order Now
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0"><i class="bi bi-info-circle me-1"></i>No meals available today.</p>
            }
        </div>
    </div>
}
else
{
    <div class="empty-state mb-4">
        <i class="bi bi-calendar-x display-1" style="color: #ccc;"></i>
        <h5 class="mt-3">No Menu Today</h5>
        <p>Check back later for today's offerings.</p>
    </div>
}

@if (Model.WeeklyMenus.Any())
{
    <h4 class="fw-bold mt-5 mb-3"><i class="bi bi-calendar-week me-2" style="color: #ff6b35;"></i>This Week</h4>
    @foreach (var menu in Model.WeeklyMenus.Where(m => m.MenuDate.Date != DateTime.Today).OrderBy(m => m.MenuDate))
    {
        <div class="week-card">
            <div class="week-card-header d-flex justify-content-between align-items-center">
                <strong><i class="bi bi-calendar-day me-2" style="color: #ff6b35;"></i>@menu.MenuDate.ToString("dddd, MMM dd")</strong>
                <span class="badge @(menu.Status == "active" ? "badge-soft-success" : "badge-soft-muted")">@menu.Status</span>
            </div>
            <div class="p-4">
                @if (menu.MenuMeals.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var meal in menu.MenuMeals)
                        {
                            <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background: #fafafa; border: 1px solid #f0f0f0;">
                                <span class="fw-semibold">@meal.RecipeName</span>
                                <span class="text-muted">@meal.Price.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No meals scheduled.</p>
                }
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        // Live quantity / sold-out updates — no page refresh
        document.addEventListener("menuMealQuantityChanged", (e) => {
            const { mealName, newQty, isSoldOut } = e.detail;
            const card = document.querySelector(`[data-menu-card="${mealName}"]`);
            if (!card) return;

            if (isSoldOut) {
                card.classList.add("opacity-50");
                const badge = card.querySelector("[data-stock-badge]");
                if (badge) {
                    badge.className = "badge badge-soft-danger";
                    badge.setAttribute("data-stock-badge", "");
                    badge.innerHTML = "Sold Out";
                }
                const footer = card.querySelector("[data-order-footer]");
                if (footer) footer.remove();
            } else {
                const countEl = card.querySelector("[data-stock-count]");
                if (countEl) countEl.textContent = newQty;
            }
        });

        // Structural changes (publish / add meal) — reload to show new content
        document.addEventListener("menuStructureChanged", () => {
            location.reload();
        });
    </script>
}
