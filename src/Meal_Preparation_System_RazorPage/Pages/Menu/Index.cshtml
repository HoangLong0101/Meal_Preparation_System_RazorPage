@page
@model Meal_Preparation_System_RazorPage.Pages.Menu.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Today's Menu";
}

<div class="page-header">
    <h2><i class="bi bi-calendar3 me-2" style="color: var(--clr-primary);"></i>Daily Menu</h2>
    <p class="mb-0">Fresh meals available for order</p>
</div>

@if (Model.TodayMenu != null)
{
    <div class="card-modern mb-4">
        <div class="px-4 py-3 d-flex justify-content-between align-items-center" style="background: var(--clr-primary); border-radius: var(--radius) var(--radius) 0 0;">
            <div class="text-white">
                <h5 class="mb-0 fw-bold"><i class="bi bi-star-fill me-2"></i>Today — @Model.TodayMenu.MenuDate.ToString("dddd, MMM dd yyyy")</h5>
            </div>
            <span class="badge bg-white text-dark">@Model.TodayMenu.Status</span>
        </div>
        <div class="card-body p-4">
            @if (Model.TodayMenu.MenuMeals.Any())
            {
                <div class="row g-3">
                    @foreach (var menuMeal in Model.TodayMenu.MenuMeals)
                    {
                        <div class="col-md-4">
                            <div class="card-modern h-100 @(menuMeal.IsSoldOut ? "opacity-50" : "")">
                                <div class="card-body">
                                    <h6 class="fw-bold">@menuMeal.RecipeName</h6>
                                    <div class="d-flex gap-1 flex-wrap mb-2">
                                        <span class="badge badge-soft-primary">@Math.Round(menuMeal.Recipe.TotalCalories, 0) kcal</span>
                                        <span class="badge badge-soft-success">P: @Math.Round(menuMeal.Recipe.ProteinG, 1)g</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mt-3">
                                        <span class="fw-bold" style="color: var(--clr-primary); font-size: 1.1rem;">@menuMeal.Price.ToString("N0") ₫</span>
                                        @if (menuMeal.IsSoldOut)
                                        {
                                            <span class="badge badge-soft-danger">Sold Out</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-box me-1"></i>@menuMeal.AvailableQuantity left</span>
                                        }
                                    </div>
                                </div>
                                @if (!menuMeal.IsSoldOut && HttpContext.Session.GetString("AccountId") != null)
                                {
                                    <div class="card-footer">
                                        <a asp-page="/Orders/Create" asp-route-menuMealId="@menuMeal.Id" class="btn btn-primary-custom btn-sm w-100">
                                            <i class="bi bi-bag-plus me-1"></i>Order Now
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0"><i class="bi bi-info-circle me-1"></i>No meals available today.</p>
            }
        </div>
    </div>
}
else
{
    <div class="empty-state mb-4">
        <i class="bi bi-calendar-x display-1 text-muted"></i>
        <h5 class="mt-3">No Menu Today</h5>
        <p>Check back later for today's offerings.</p>
    </div>
}

@if (Model.WeeklyMenus.Any())
{
    <h4 class="fw-bold mt-5 mb-3"><i class="bi bi-calendar-week me-2"></i>This Week</h4>
    @foreach (var menu in Model.WeeklyMenus.Where(m => m.MenuDate.Date != DateTime.Today).OrderBy(m => m.MenuDate))
    {
        <div class="card-modern mb-3">
            <div class="card-header bg-transparent px-4 py-3 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid var(--clr-border);">
                <strong><i class="bi bi-calendar-day me-2"></i>@menu.MenuDate.ToString("dddd, MMM dd")</strong>
                <span class="badge @(menu.Status == "active" ? "badge-soft-success" : "badge-soft-muted")">@menu.Status</span>
            </div>
            <div class="card-body p-4">
                @if (menu.MenuMeals.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var meal in menu.MenuMeals)
                        {
                            <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background: var(--clr-bg); border: 1px solid var(--clr-border);">
                                <span class="fw-semibold">@meal.RecipeName</span>
                                <span class="text-muted">@meal.Price.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No meals scheduled.</p>
                }
            </div>
        </div>
    }
}
