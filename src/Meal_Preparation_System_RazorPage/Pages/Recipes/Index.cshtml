@page
@model Meal_Preparation_System_RazorPage.Pages.Recipes.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Recipes";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="bi bi-book me-2" style="color: var(--clr-primary);"></i>Recipes</h2>
            <p class="mb-0">Explore our collection of nutritious recipes</p>
        </div>
        @if (HttpContext.Session.GetString("AccountId") != null)
        {
            <a asp-page="/Recipes/Create" class="btn btn-primary-custom">
                <i class="bi bi-plus-lg me-1"></i> Add Recipe
            </a>
        }
    </div>
</div>

@if (!Model.Recipes.Any())
{
    <div class="empty-state">
        <i class="bi bi-book display-1 text-muted"></i>
        <h5 class="mt-3">No Recipes Yet</h5>
        <p>Be the first to add a recipe to the collection.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var recipe in Model.Recipes)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card-modern h-100 d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <h5 class="fw-bold mb-2">@recipe.RecipeName</h5>
                        <div class="d-flex gap-2 flex-wrap mb-3">
                            <span class="badge badge-soft-primary">@Math.Round(recipe.TotalCalories, 0) kcal</span>
                            <span class="badge badge-soft-success">P: @Math.Round(recipe.ProteinG, 1)g</span>
                            <span class="badge badge-soft-warning">C: @Math.Round(recipe.CarbsG, 1)g</span>
                            <span class="badge badge-soft-danger">F: @Math.Round(recipe.FatG, 1)g</span>
                        </div>
                        <p class="text-muted small flex-grow-1">
                            @(recipe.Instructions.Length > 120 ? recipe.Instructions[..120] + "..." : recipe.Instructions)
                        </p>
                        @if (recipe.Ingredients.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mt-auto">
                                @foreach (var ing in recipe.Ingredients.Take(4))
                                {
                                    <span class="ingredient-tag">@ing.IngredientName</span>
                                }
                                @if (recipe.Ingredients.Count > 4)
                                {
                                    <span class="ingredient-tag">+@(recipe.Ingredients.Count - 4) more</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-page="/Recipes/Details" asp-route-id="@recipe.Id" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-eye me-1"></i>View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
