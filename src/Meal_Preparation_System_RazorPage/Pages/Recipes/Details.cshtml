@page "{id}"
@model Meal_Preparation_System_RazorPage.Pages.Recipes.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Recipe.RecipeName;
}

<style>
    .recipe-detail-header { background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%); border-radius: 16px; padding: 28px; margin-bottom: 24px; }
    .recipe-detail-header h2 { font-weight: 700; color: #1a1a2e; }
    .nutrition-stat { background: white; border-radius: 12px; padding: 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.06); border: 1px solid rgba(0,0,0,0.04); }
    .nutrition-stat .stat-label { font-size: 0.78rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; }
    .nutrition-stat .stat-value { font-size: 1.5rem; font-weight: 700; }
    .instructions-box { background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%); border-radius: 12px; padding: 20px; border: 1px solid #f0f0f0; white-space: pre-wrap; line-height: 1.7; }
    .ingredient-allergen { background: #fff3cd; color: #856404; border-radius: 20px; padding: 2px 10px; font-size: 0.75rem; font-weight: 500; }
</style>

<a asp-page="/Recipes/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Recipes</a>

<div class="recipe-detail-header">
    <h2><i class="bi bi-book me-2" style="color: #ff6b35;"></i>@Model.Recipe.RecipeName</h2>

    <div class="row g-3 mt-3">
        <div class="col-6 col-sm-3">
            <div class="nutrition-stat">
                <div class="stat-label">Calories</div>
                <div class="stat-value" style="color: #ff6b35;">@Math.Round(Model.Recipe.TotalCalories, 0)</div>
                <div class="stat-label">kcal</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="nutrition-stat">
                <div class="stat-label">Protein</div>
                <div class="stat-value" style="color: #28a745;">@Math.Round(Model.Recipe.ProteinG, 1)</div>
                <div class="stat-label">grams</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="nutrition-stat">
                <div class="stat-label">Carbs</div>
                <div class="stat-value" style="color: #ffc107;">@Math.Round(Model.Recipe.CarbsG, 1)</div>
                <div class="stat-label">grams</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="nutrition-stat">
                <div class="stat-label">Fat</div>
                <div class="stat-value" style="color: #dc3545;">@Math.Round(Model.Recipe.FatG, 1)</div>
                <div class="stat-label">grams</div>
            </div>
        </div>
    </div>
</div>

<div class="card-modern p-4">
    @if (Model.Recipe.Ingredients.Any())
    {
        <h5 class="fw-bold mb-3"><i class="bi bi-list-check me-2" style="color: #ff6b35;"></i>Ingredients</h5>
        <div class="table-responsive mb-4">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>Ingredient</th>
                        <th>Amount</th>
                        <th>Unit</th>
                        <th>Cal/Unit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ing in Model.Recipe.Ingredients)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@ing.IngredientName</span>
                                @if (ing.IsAllergen)
                                {
                                    <span class="ingredient-allergen ms-2"><i class="bi bi-exclamation-triangle me-1"></i>Allergen</span>
                                }
                            </td>
                            <td>@ing.Amount</td>
                            <td>@ing.Unit</td>
                            <td>@ing.CaloPerUnit</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-journal-text me-2" style="color: #ff6b35;"></i>Instructions</h5>
    <div class="instructions-box">@Model.Recipe.Instructions</div>
</div>
