@page "{id}"
@model Meal_Preparation_System_RazorPage.Pages.Recipes.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Recipe.RecipeName;
}

<a asp-page="/Recipes/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Recipes</a>

<div class="card-modern p-4">
    <h2 class="fw-bold">@Model.Recipe.RecipeName</h2>

    <div class="row g-3 mt-3 mb-4">
        <div class="col-6 col-sm-3">
            <div class="stat-card">
                <div class="stat-label">Calories</div>
                <div class="stat-value" style="color: var(--clr-primary);">@Math.Round(Model.Recipe.TotalCalories, 0)</div>
                <div class="stat-label">kcal</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="stat-card">
                <div class="stat-label">Protein</div>
                <div class="stat-value" style="color: var(--clr-success);">@Math.Round(Model.Recipe.ProteinG, 1)</div>
                <div class="stat-label">grams</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="stat-card">
                <div class="stat-label">Carbs</div>
                <div class="stat-value" style="color: var(--clr-warning);">@Math.Round(Model.Recipe.CarbsG, 1)</div>
                <div class="stat-label">grams</div>
            </div>
        </div>
        <div class="col-6 col-sm-3">
            <div class="stat-card">
                <div class="stat-label">Fat</div>
                <div class="stat-value" style="color: var(--clr-danger);">@Math.Round(Model.Recipe.FatG, 1)</div>
                <div class="stat-label">grams</div>
            </div>
        </div>
    </div>

    @if (Model.Recipe.Ingredients.Any())
    {
        <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-list-check me-2"></i>Ingredients</h5>
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th>Ingredient</th>
                        <th>Amount</th>
                        <th>Unit</th>
                        <th>Cal/Unit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ing in Model.Recipe.Ingredients)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@ing.IngredientName</span>
                                @if (ing.IsAllergen)
                                {
                                    <span class="badge badge-soft-warning ms-2"><i class="bi bi-exclamation-triangle me-1"></i>Allergen</span>
                                }
                            </td>
                            <td>@ing.Amount</td>
                            <td>@ing.Unit</td>
                            <td>@ing.CaloPerUnit</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-journal-text me-2"></i>Instructions</h5>
    <div class="p-3" style="background: var(--clr-bg); border-radius: var(--radius); white-space: pre-wrap; line-height: 1.7;">@Model.Recipe.Instructions</div>
</div>
