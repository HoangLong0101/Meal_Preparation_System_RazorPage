@page "{id}"
@model Meal_Preparation_System_RazorPage.Pages.Orders.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Order Details";
}

<style>
    .order-detail-header { background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%); border-radius: 16px; padding: 28px; margin-bottom: 24px; }
    .order-detail-header h3 { font-weight: 700; color: #1a1a2e; }
    .order-stat-card { background: white; border-radius: 12px; padding: 18px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.06); border: 1px solid rgba(255,107,53,0.1); }
    .order-stat-card .stat-icon { width: 40px; height: 40px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 8px; font-size: 1.1rem; }
    .order-stat-card .stat-label { font-size: 0.78rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; }
    .order-stat-card .stat-value { font-weight: 700; font-size: 1.05rem; color: #1a1a2e; }
    .delivery-section { background: linear-gradient(135deg, #f0f9ff 0%, #e8f4fd 100%); border-radius: 12px; padding: 20px; border: 1px solid rgba(13,110,253,0.1); }
</style>

<a asp-page="/Orders/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Orders</a>

<div class="order-detail-header">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0"><i class="bi bi-receipt me-2" style="color: #ff6b35;"></i>Order Details</h3>
        <span id="order-status-badge" class="badge fs-6 px-3 py-2 @(Model.Order.Status switch
        {
            "Completed" => "badge-soft-success",
            "Pending" => "badge-soft-warning",
            "Cancelled" => "badge-soft-danger",
            _ => "badge-soft-muted"
        })">@Model.Order.Status</span>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="order-stat-card">
                <div class="stat-icon" style="background: #fff5f0; color: #ff6b35;"><i class="bi bi-calendar"></i></div>
                <div class="stat-label">Order Date</div>
                <div class="stat-value">@Model.Order.OrderDate.ToString("MMM dd, yyyy HH:mm")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="order-stat-card">
                <div class="stat-icon" style="background: #e8f5e9; color: #28a745;"><i class="bi bi-credit-card"></i></div>
                <div class="stat-label">Payment Method</div>
                <div class="stat-value">@(Model.Order.PaymentMethod ?? "—")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="order-stat-card">
                <div class="stat-icon" style="background: #fff5f0; color: #ff6b35;"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-label">Total</div>
                <div class="stat-value fs-5" style="color: #ff6b35;">@Model.Order.TotalAmount.ToString("N0") ₫</div>
            </div>
        </div>
    </div>
</div>

<div class="card-modern p-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-list-ul me-2" style="color: #ff6b35;"></i>Items</h5>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.Order.OrderDetails)
                {
                    <tr>
                        <td class="fw-semibold">@(detail.MenuMeal?.RecipeName ?? "—")</td>
                        <td><span class="badge badge-soft-muted">×@detail.Quantity</span></td>
                        <td>@detail.UnitPrice.ToString("N0") ₫</td>
                        <td class="fw-bold">@((detail.UnitPrice * detail.Quantity).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Order.DeliverySchedule != null)
    {
        <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-truck me-2" style="color: #0d6efd;"></i>Delivery Info</h5>
        <div class="delivery-section">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase fw-semibold mb-1">Address</div>
                    <div class="fw-semibold">@Model.Order.DeliverySchedule.Address</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase fw-semibold mb-1">Delivery Time</div>
                    <div class="fw-semibold">@Model.Order.DeliverySchedule.DeliveryTime.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase fw-semibold mb-1">Driver Contact</div>
                    <div class="fw-semibold">@Model.Order.DeliverySchedule.DriverContact</div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const orderId = "@Model.Order.Id";

            if (typeof mealPrepConnection !== "undefined") {
                // Connection is already started from _Layout — just join the order group
                if (mealPrepConnection.state === "Connected") {
                    mealPrepConnection.invoke("JoinOrderGroup", orderId).catch(() => { });
                } else {
                    mealPrepConnection.onreconnected(() => {
                        mealPrepConnection.invoke("JoinOrderGroup", orderId).catch(() => { });
                    });
                }

                document.addEventListener("orderStatusUpdated", (e) => {
                    if (e.detail.orderId === orderId) {
                        const badge = document.getElementById("order-status-badge");
                        if (badge) {
                            badge.textContent = e.detail.newStatus;
                            badge.className = "badge fs-6 px-3 py-2 " + getStatusBadgeClass(e.detail.newStatus);
                        }
                    }
                });
            }

            function getStatusBadgeClass(status) {
                switch (status.toLowerCase()) {
                    case "completed": case "confirmed": case "delivered": return "badge-soft-success";
                    case "pending": case "pending_payment": return "badge-soft-warning";
                    case "cancelled": case "payment_failed": return "badge-soft-danger";
                    default: return "badge-soft-muted";
                }
            }
        })();
    </script>
}
