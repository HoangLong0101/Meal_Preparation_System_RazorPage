@page "{id}"
@model Meal_Preparation_System_RazorPage.Pages.Orders.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Order Details";
}

<a asp-page="/Orders/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Orders</a>

<div class="card-modern p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0"><i class="bi bi-receipt me-2" style="color: var(--clr-primary);"></i>Order Details</h3>
        <span id="order-status-badge" class="badge fs-6 px-3 py-2 @(Model.Order.Status switch
        {
            "Completed" => "badge-soft-success",
            "Pending" => "badge-soft-warning",
            "Cancelled" => "badge-soft-danger",
            _ => "badge-soft-muted"
        })">@Model.Order.Status</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card text-start">
                <div class="stat-label"><i class="bi bi-calendar me-1"></i>Order Date</div>
                <div class="fw-bold mt-1">@Model.Order.OrderDate.ToString("MMM dd, yyyy HH:mm")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card text-start">
                <div class="stat-label"><i class="bi bi-credit-card me-1"></i>Payment Method</div>
                <div class="fw-bold mt-1">@(Model.Order.PaymentMethod ?? "—")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card text-start">
                <div class="stat-label"><i class="bi bi-cash-stack me-1"></i>Total</div>
                <div class="fw-bold mt-1 fs-5" style="color: var(--clr-primary);">@Model.Order.TotalAmount.ToString("N0") ₫</div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3"><i class="bi bi-list-ul me-2"></i>Items</h5>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detail in Model.Order.OrderDetails)
                {
                    <tr>
                        <td class="fw-semibold">@(detail.MenuMeal?.RecipeName ?? "—")</td>
                        <td><span class="badge badge-soft-muted">×@detail.Quantity</span></td>
                        <td>@detail.UnitPrice.ToString("N0") ₫</td>
                        <td class="fw-bold">@((detail.UnitPrice * detail.Quantity).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Order.DeliverySchedule != null)
    {
        <h5 class="fw-bold mt-4 mb-3"><i class="bi bi-truck me-2"></i>Delivery Info</h5>
        <div class="p-4 rounded-3" style="background: var(--clr-bg); border: 1px solid var(--clr-border);">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase fw-semibold mb-1">Address</div>
                    <div class="fw-semibold">@Model.Order.DeliverySchedule.Address</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase fw-semibold mb-1">Delivery Time</div>
                    <div class="fw-semibold">@Model.Order.DeliverySchedule.DeliveryTime.ToString("MMM dd, yyyy HH:mm")</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small text-uppercase fw-semibold mb-1">Driver Contact</div>
                    <div class="fw-semibold">@Model.Order.DeliverySchedule.DriverContact</div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const orderId = "@Model.Order.Id";

            if (typeof mealPrepConnection !== "undefined") {
                // Connection is already started from _Layout — just join the order group
                if (mealPrepConnection.state === "Connected") {
                    mealPrepConnection.invoke("JoinOrderGroup", orderId).catch(() => { });
                } else {
                    mealPrepConnection.onreconnected(() => {
                        mealPrepConnection.invoke("JoinOrderGroup", orderId).catch(() => { });
                    });
                }

                document.addEventListener("orderStatusUpdated", (e) => {
                    if (e.detail.orderId === orderId) {
                        const badge = document.getElementById("order-status-badge");
                        if (badge) {
                            badge.textContent = e.detail.newStatus;
                            badge.className = "badge fs-6 px-3 py-2 " + getStatusBadgeClass(e.detail.newStatus);
                        }
                    }
                });
            }

            function getStatusBadgeClass(status) {
                switch (status.toLowerCase()) {
                    case "completed": case "confirmed": case "delivered": return "badge-soft-success";
                    case "pending": case "pending_payment": return "badge-soft-warning";
                    case "cancelled": case "payment_failed": return "badge-soft-danger";
                    default: return "badge-soft-muted";
                }
            }
        })();
    </script>
}
