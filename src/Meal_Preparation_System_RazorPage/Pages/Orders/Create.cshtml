@page
@model Meal_Preparation_System_RazorPage.Pages.Orders.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Place Order";
}

<style>
    .order-card { border-radius: 16px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.08); border: none; }
    .order-card-header { background: linear-gradient(135deg, #ff6b35, #ff8c5a); padding: 28px; text-align: center; color: white; }
    .order-card-header i { font-size: 2.5rem; margin-bottom: 8px; }
    .order-card-header h3 { font-weight: 700; margin: 0; }
    .order-card-body { padding: 28px; background: white; }
    .meal-preview { background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%); border-radius: 12px; padding: 20px; border: 1px solid rgba(255,107,53,0.15); }
    .meal-preview .price { font-size: 1.3rem; font-weight: 700; color: #ff6b35; }
    .input-group-order .input-group-text { background: #fff5f0; border-color: #ffe0cc; color: #ff6b35; }
    .input-group-order .form-control { border-color: #ffe0cc; }
    .input-group-order .form-control:focus { border-color: #ff6b35; box-shadow: 0 0 0 0.2rem rgba(255,107,53,0.15); }
    .btn-order { background: linear-gradient(135deg, #ff6b35, #ff8c5a); border: none; color: white; padding: 14px; border-radius: 12px; font-weight: 600; font-size: 1rem; }
    .btn-order:hover { background: linear-gradient(135deg, #e55a2b, #ff6b35); color: white; transform: translateY(-1px); box-shadow: 0 4px 15px rgba(255,107,53,0.3); }
    #deliveryMap { width: 100%; height: 300px; border-radius: 8px; border: 1px solid #ffe0cc; margin-top: 8px; }
</style>

<a asp-page="/Menu/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Menu</a>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="order-card">
            <div class="order-card-header">
                <i class="bi bi-bag-check"></i>
                <h3>Place Order</h3>
            </div>
            <div class="order-card-body">
                @if (Model.SelectedMeal != null)
                {
                    <div class="meal-preview mb-4">
                        <h5 class="fw-bold mb-2">@Model.SelectedMeal.RecipeName</h5>
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge badge-soft-primary">@Math.Round(Model.SelectedMeal.Recipe.TotalCalories, 0) kcal</span>
                            <span class="badge badge-soft-success">P: @Math.Round(Model.SelectedMeal.Recipe.ProteinG, 1)g</span>
                            <span class="badge badge-soft-warning">C: @Math.Round(Model.SelectedMeal.Recipe.CarbsG, 1)g</span>
                            <span class="badge badge-soft-danger">F: @Math.Round(Model.SelectedMeal.Recipe.FatG, 1)g</span>
                        </div>
                        <div class="price mt-2">@Model.SelectedMeal.Price.ToString("N0") ₫ <span class="text-muted small fw-normal">each</span></div>
                    </div>

                    <form method="post" data-confirm='{"title":"Confirm Order?","message":"Your order will be created and payment flow will start.","icon":"bi-bag-check","confirmText":"Continue","cancelText":"Go Back"}'>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MenuMealId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Quantity</label>
                            <div class="input-group input-group-order">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input asp-for="Quantity" class="form-control" type="number" min="1"
                                       max="@Model.SelectedMeal.AvailableQuantity" required />
                            </div>
                            <small class="text-muted"><i class="bi bi-box me-1"></i>@Model.SelectedMeal.AvailableQuantity available</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Delivery Address</label>
                            <div class="input-group input-group-order">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="DeliveryAddress" class="form-control" placeholder="Enter delivery address" required />
                            </div>
                            <small class="text-muted"><i class="bi bi-pin-map me-1"></i>Type to search, click the map, or use your current location</small>
                            <small id="mapsStatus" class="text-muted d-block mt-1"></small>
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="toggleMapBtn" style="display:none;">
                                    <i class="bi bi-map"></i> Show Map
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="useLocationBtn" style="display:none;">
                                    <i class="bi bi-crosshair"></i> Use My Location
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-success" id="trackLocationBtn" style="display:none;">
                                    <i class="bi bi-broadcast-pin"></i> Start Live Tracking
                                </button>
                            </div>
                            <div id="deliveryMap" style="display:none;"></div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Preferred Delivery Time</label>
                            <div class="input-group input-group-order">
                                <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                <input asp-for="DeliveryTime" class="form-control" type="datetime-local" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Driver Contact (Optional)</label>
                            <div class="input-group input-group-order">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="DriverContact" class="form-control" placeholder="Optional note for delivery contact" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select form-control-modern">
                                <option value="COD">Cash on Delivery (COD)</option>
                                <option value="VNPAY">VNPAY</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-order w-100">
                            <i class="bi bi-check-lg me-1"></i> Place Order
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>

    <script>
        let mapboxTimeout;
        const mapboxAccessToken = '@Model.MapboxAccessToken';
        let map = null;
        let mapInitialized = false;
        let deliveryMarker = null;
        let locationWatchId = null;

        function setMapsStatus(message, isError) {
            const status = document.getElementById('mapsStatus');
            if (!status) {
                return;
            }

            status.classList.remove('text-muted', 'text-danger');
            status.classList.add(isError ? 'text-danger' : 'text-muted');
            status.textContent = message;
        }

        async function reverseGeocodeMapbox(longitude, latitude) {
            if (!mapboxAccessToken) return null;
            
            try {
                const response = await fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${longitude},${latitude}.json?access_token=${encodeURIComponent(mapboxAccessToken)}&language=vi`);
                if (!response.ok) return null;
                
                const payload = await response.json();
                if (payload.features && payload.features.length > 0) {
                    return payload.features[0].place_name;
                }
            } catch (error) {
                console.error('Reverse geocode error:', error);
            }
            return null;
        }

        async function updateAddressFromCoordinates(longitude, latitude, statusMessage) {
            const input = document.getElementById('DeliveryAddress');
            if (!input) {
                return;
            }

            const address = await reverseGeocodeMapbox(longitude, latitude);
            if (!address) {
                setMapsStatus('Could not resolve an address for this location.', true);
                return;
            }

            input.value = address;
            setMapsStatus(statusMessage, false);
        }

        function ensureMarker() {
            if (!map) {
                return null;
            }

            if (!deliveryMarker) {
                deliveryMarker = new mapboxgl.Marker({ color: '#ff6b35', draggable: false });
            }

            return deliveryMarker;
        }

        function initializeMap() {
            if (mapInitialized || !mapboxAccessToken) return;
            
            const mapContainer = document.getElementById('deliveryMap');
            if (!mapContainer) return;

            mapboxgl.accessToken = mapboxAccessToken;
            map = new mapboxgl.Map({
                container: 'deliveryMap',
                style: 'mapbox://styles/mapbox/streets-v12',
                center: [106.6655, 10.8231],
                zoom: 11
            });

            map.on('click', async function (e) {
                const coords = e.lngLat;
                const marker = ensureMarker();
                if (marker) {
                    marker.setLngLat(coords).addTo(map);
                }

                await updateAddressFromCoordinates(coords.lng, coords.lat, 'Address selected from map.');
            });

            map.on('load', function () {
                setMapsStatus('Click on the map to select a delivery location.', false);
            });

            mapInitialized = true;
        }

        function showMap() {
            const mapContainer = document.getElementById('deliveryMap');
            const toggleBtn = document.getElementById('toggleMapBtn');

            if (!mapContainer || !toggleBtn) {
                return;
            }

            mapContainer.style.display = 'block';
            toggleBtn.innerHTML = '<i class="bi bi-map"></i> Hide Map';

            if (!mapInitialized) {
                setTimeout(initializeMap, 100);
            } else if (map) {
                map.resize();
            }
        }

        function toggleMap() {
            const mapContainer = document.getElementById('deliveryMap');
            const toggleBtn = document.getElementById('toggleMapBtn');
            
            if (!mapContainer || !toggleBtn) return;

            if (mapContainer.style.display === 'none') {
                showMap();
            } else {
                mapContainer.style.display = 'none';
                toggleBtn.innerHTML = '<i class="bi bi-map"></i> Show Map';
            }
        }

        async function applyCurrentLocation(position, statusMessage) {
            const latitude = position.coords.latitude;
            const longitude = position.coords.longitude;

            showMap();

            const updateMapLocation = () => {
                if (!map) {
                    return;
                }

                const lngLat = [longitude, latitude];
                map.flyTo({ center: lngLat, zoom: 15 });
                const marker = ensureMarker();
                if (marker) {
                    marker.setLngLat(lngLat).addTo(map);
                }
            };

            if (!mapInitialized) {
                initializeMap();
                setTimeout(updateMapLocation, 300);
            } else {
                updateMapLocation();
            }

            await updateAddressFromCoordinates(longitude, latitude, statusMessage);
        }

        function handleLocationError(error) {
            if (error.code === error.PERMISSION_DENIED) {
                setMapsStatus('Location permission denied. Please allow location access in your browser.', true);
                return;
            }

            if (error.code === error.TIMEOUT) {
                setMapsStatus('Timed out while getting your location. Try again.', true);
                return;
            }

            setMapsStatus('Unable to get your current location.', true);
        }

        function useCurrentLocation() {
            if (!navigator.geolocation) {
                setMapsStatus('Geolocation is not supported by this browser.', true);
                return;
            }

            setMapsStatus('Getting your current location...', false);
            navigator.geolocation.getCurrentPosition(
                position => applyCurrentLocation(position, 'Current location applied.'),
                handleLocationError,
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
        }

        function toggleLiveTracking() {
            const trackButton = document.getElementById('trackLocationBtn');
            if (!trackButton) {
                return;
            }

            if (locationWatchId !== null) {
                navigator.geolocation.clearWatch(locationWatchId);
                locationWatchId = null;
                trackButton.innerHTML = '<i class="bi bi-broadcast-pin"></i> Start Live Tracking';
                trackButton.classList.remove('btn-success');
                trackButton.classList.add('btn-outline-success');
                setMapsStatus('Live tracking stopped.', false);
                return;
            }

            if (!navigator.geolocation) {
                setMapsStatus('Geolocation is not supported by this browser.', true);
                return;
            }

            setMapsStatus('Starting live location tracking...', false);
            locationWatchId = navigator.geolocation.watchPosition(
                position => applyCurrentLocation(position, 'Live location updated.'),
                error => {
                    handleLocationError(error);
                    if (locationWatchId !== null) {
                        navigator.geolocation.clearWatch(locationWatchId);
                        locationWatchId = null;
                    }
                    trackButton.innerHTML = '<i class="bi bi-broadcast-pin"></i> Start Live Tracking';
                    trackButton.classList.remove('btn-success');
                    trackButton.classList.add('btn-outline-success');
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 3000 });

            trackButton.innerHTML = '<i class="bi bi-pause-circle"></i> Stop Live Tracking';
            trackButton.classList.remove('btn-outline-success');
            trackButton.classList.add('btn-success');
        }

        async function searchMapbox(query) {
            const input = document.getElementById('DeliveryAddress');
            const datalist = document.getElementById('deliveryAddressSuggestions');
            if (!input || !datalist) {
                return;
            }

            if (!query || query.length < 3) {
                datalist.innerHTML = '';
                return;
            }

            if (!mapboxAccessToken) {
                return;
            }

            try {
                const response = await fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(query)}.json?access_token=${encodeURIComponent(mapboxAccessToken)}&autocomplete=true&limit=5&country=VN&language=vi`);
                if (!response.ok) {
                    throw new Error(`Mapbox API error: ${response.status}`);
                }

                const payload = await response.json();
                const features = Array.isArray(payload.features) ? payload.features : [];
                datalist.innerHTML = features
                    .map(feature => `<option value="${feature.place_name}"></option>`)
                    .join('');

                if (features.length > 0) {
                    setMapsStatus('Address suggestions are ready.', false);
                } else {
                    setMapsStatus('No matching address found. You can still enter manually.', false);
                }
            } catch (error) {
                setMapsStatus('Cannot load Mapbox suggestions. You can still enter address manually.', true);
            }
        }

        function initDeliveryAutocomplete() {
            const input = document.getElementById('DeliveryAddress');
            if (!input) {
                return;
            }

            if (!mapboxAccessToken) {
                setMapsStatus('Mapbox access token is missing. You can still enter address manually.', true);
                return;
            }

            const toggleBtn = document.getElementById('toggleMapBtn');
            if (toggleBtn) {
                toggleBtn.style.display = 'block';
                toggleBtn.addEventListener('click', toggleMap);
            }

            const useLocationBtn = document.getElementById('useLocationBtn');
            if (useLocationBtn) {
                useLocationBtn.style.display = 'block';
                useLocationBtn.addEventListener('click', useCurrentLocation);
            }

            const trackLocationBtn = document.getElementById('trackLocationBtn');
            if (trackLocationBtn) {
                trackLocationBtn.style.display = 'block';
                trackLocationBtn.addEventListener('click', toggleLiveTracking);
            }

            input.addEventListener('input', function () {
                clearTimeout(mapboxTimeout);
                const query = this.value;
                mapboxTimeout = setTimeout(() => searchMapbox(query), 300);
            });

            setMapsStatus('Mapbox address suggestions and map are ready.', false);
        }

        document.addEventListener('DOMContentLoaded', initDeliveryAutocomplete);
    </script>

    <datalist id="deliveryAddressSuggestions"></datalist>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('DeliveryAddress');
            if (input) {
                input.setAttribute('list', 'deliveryAddressSuggestions');
            }
        });
    </script>

}
