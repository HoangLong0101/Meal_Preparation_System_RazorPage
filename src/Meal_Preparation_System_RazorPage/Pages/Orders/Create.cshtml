@page
@model Meal_Preparation_System_RazorPage.Pages.Orders.CreateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Place Order";
}

<style>
    .order-card { border-radius: 16px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.08); border: none; }
    .order-card-header { background: linear-gradient(135deg, #ff6b35, #ff8c5a); padding: 28px; text-align: center; color: white; }
    .order-card-header i { font-size: 2.5rem; margin-bottom: 8px; }
    .order-card-header h3 { font-weight: 700; margin: 0; }
    .order-card-body { padding: 28px; background: white; }
    .meal-preview { background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%); border-radius: 12px; padding: 20px; border: 1px solid rgba(255,107,53,0.15); }
    .meal-preview .price { font-size: 1.3rem; font-weight: 700; color: #ff6b35; }
    .input-group-order .input-group-text { background: #fff5f0; border-color: #ffe0cc; color: #ff6b35; }
    .input-group-order .form-control { border-color: #ffe0cc; }
    .input-group-order .form-control:focus { border-color: #ff6b35; box-shadow: 0 0 0 0.2rem rgba(255,107,53,0.15); }
    .btn-order { background: linear-gradient(135deg, #ff6b35, #ff8c5a); border: none; color: white; padding: 14px; border-radius: 12px; font-weight: 600; font-size: 1rem; }
    .btn-order:hover { background: linear-gradient(135deg, #e55a2b, #ff6b35); color: white; transform: translateY(-1px); box-shadow: 0 4px 15px rgba(255,107,53,0.3); }
</style>

<a asp-page="/Menu/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Menu</a>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="order-card">
            <div class="order-card-header">
                <i class="bi bi-bag-check"></i>
                <h3>Place Order</h3>
            </div>
            <div class="order-card-body">
                @if (Model.SelectedMeal != null)
                {
                    <div class="meal-preview mb-4">
                        <h5 class="fw-bold mb-2">@Model.SelectedMeal.RecipeName</h5>
                        <div class="d-flex gap-1 flex-wrap mb-2">
                            <span class="badge badge-soft-primary">@Math.Round(Model.SelectedMeal.Recipe.TotalCalories, 0) kcal</span>
                            <span class="badge badge-soft-success">P: @Math.Round(Model.SelectedMeal.Recipe.ProteinG, 1)g</span>
                            <span class="badge badge-soft-warning">C: @Math.Round(Model.SelectedMeal.Recipe.CarbsG, 1)g</span>
                            <span class="badge badge-soft-danger">F: @Math.Round(Model.SelectedMeal.Recipe.FatG, 1)g</span>
                        </div>
                        <div class="price mt-2">@Model.SelectedMeal.Price.ToString("N0") ₫ <span class="text-muted small fw-normal">each</span></div>
                    </div>

                    <form method="post" data-confirm='{"title":"Confirm Order?","message":"Your order will be created and payment flow will start.","icon":"bi-bag-check","confirmText":"Continue","cancelText":"Go Back"}'>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MenuMealId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Quantity</label>
                            <div class="input-group input-group-order">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input asp-for="Quantity" class="form-control" type="number" min="1"
                                       max="@Model.SelectedMeal.AvailableQuantity" required />
                            </div>
                            <small class="text-muted"><i class="bi bi-box me-1"></i>@Model.SelectedMeal.AvailableQuantity available</small>
                        </div>

                        <div class="mb-4 position-relative">
                            <label class="form-label fw-semibold">Delivery Address</label>
                            <div class="input-group input-group-order">
                                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="DeliveryAddress" class="form-control" placeholder="Enter delivery address" autocomplete="off" required />
                            </div>
                            <div id="addressSuggestions" class="suggestions-dropdown position-absolute" style="display:none; top:100%; left:0; right:0; background:white; border:1px solid #e0e0e0; border-radius:8px; max-height:300px; overflow-y:auto; z-index:1000; margin-top:4px;"></div>
                            <small class="text-muted"><i class="bi bi-pin-map me-1"></i>Type to search addresses (powered by OpenStreetMap)</small>
                            <small id="mapsStatus" class="text-muted d-block mt-1"></small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Preferred Delivery Time</label>
                            <div class="input-group input-group-order">
                                <span class="input-group-text"><i class="bi bi-clock"></i></span>
                                <input asp-for="DeliveryTime" class="form-control" type="datetime-local" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Driver Contact (Optional)</label>
                            <div class="input-group input-group-order">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="DriverContact" class="form-control" placeholder="Optional note for delivery contact" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select form-control-modern">
                                <option value="COD">Cash on Delivery (COD)</option>
                                <option value="VNPAY">VNPAY</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-order w-100">
                            <i class="bi bi-check-lg me-1"></i> Place Order
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let nominatimTimeout;
        const NOMINATIM_API = 'https://nominatim.openstreetmap.org/search';

        function setMapsStatus(message, isError) {
            const status = document.getElementById('mapsStatus');
            if (!status) return;
            status.classList.remove('text-muted', 'text-danger');
            status.classList.add(isError ? 'text-danger' : 'text-muted');
            status.textContent = message;
        }

        function hideSuggestions() {
            const dropdown = document.getElementById('addressSuggestions');
            if (dropdown) dropdown.style.display = 'none';
        }

        function showSuggestions(suggestions) {
            const dropdown = document.getElementById('addressSuggestions');
            if (!dropdown) return;
            
            if (suggestions.length === 0) {
                dropdown.style.display = 'none';
                return;
            }

            dropdown.innerHTML = suggestions.map((item, idx) => `
                <div class="suggestion-item p-2 border-bottom cursor-pointer" style="cursor:pointer; padding:8px 12px;" data-address="${item.display_name}" onmouseover="this.style.backgroundColor='#f5f5f5'" onmouseout="this.style.backgroundColor='white'">
                    <small><strong>${item.display_name.substring(0, 60)}</strong></small>
                    ${item.display_name.length > 60 ? `<small class="text-muted">...</small>` : ''}
                </div>
            `).join('');
            
            dropdown.style.display = 'block';
            
            dropdown.querySelectorAll('.suggestion-item').forEach(item => {
                item.addEventListener('click', function () {
                    const input = document.getElementById('DeliveryAddress');
                    if (input) {
                        input.value = this.getAttribute('data-address');
                        input.focus();
                    }
                    hideSuggestions();
                });
            });
        }

        function searchNominatim(query) {
            if (!query || query.length < 3) {
                hideSuggestions();
                return;
            }

            fetch(`${NOMINATIM_API}?q=${encodeURIComponent(query)}&countrycodes=vn&format=json&addressdetails=1&limit=8`)
                .then(resp => resp.json())
                .then(data => {
                    showSuggestions(data || []);
                    if (data && data.length > 0) {
                        setMapsStatus('Address suggestions ready', false);
                    } else if (query.length >= 3) {
                        setMapsStatus('No addresses found', false);
                    }
                })
                .catch(err => {
                    console.error('Nominatim error:', err);
                    setMapsStatus('Cannot load suggestions. Enter address manually.', true);
                });
        }

        function initDeliveryAutocomplete() {
            const input = document.getElementById('DeliveryAddress');
            if (!input) return;

            input.addEventListener('input', function () {
                clearTimeout(nominatimTimeout);
                nominatimTimeout = setTimeout(() => {
                    searchNominatim(this.value);
                }, 300);
            });

            input.addEventListener('focus', function () {
                if (this.value && this.value.length >= 3) {
                    searchNominatim(this.value);
                }
            });

            document.addEventListener('click', function (e) {
                if (!e.target.closest('#DeliveryAddress') && !e.target.closest('#addressSuggestions')) {
                    hideSuggestions();
                }
            });

            setMapsStatus('Address suggestions ready (OpenStreetMap)', false);
        }

        document.addEventListener('DOMContentLoaded', initDeliveryAutocomplete);
    </script>
}
