@page
@model Meal_Preparation_System_RazorPage.Pages.Orders.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Orders";
}

<style>
    .orders-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        border-radius: 16px;
        padding: 32px;
        margin-bottom: 24px;
    }
    .orders-header h2 { font-weight: 700; color: #1a1a2e; margin-bottom: 4px; }
    .orders-header p { color: #666; }
    .order-stat { background: white; border-radius: 12px; padding: 16px 20px; text-align: center; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .order-stat .stat-num { font-size: 1.5rem; font-weight: 700; color: #ff6b35; }
    .order-stat .stat-lbl { font-size: 0.8rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; }
</style>

<div class="orders-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2><i class="bi bi-bag me-2" style="color: #ff6b35;"></i>My Orders</h2>
            <p class="mb-0">Track all your meal orders</p>
        </div>
        <div class="d-flex gap-3">
            <div class="order-stat">
                <div class="stat-num">@Model.Orders.Count()</div>
                <div class="stat-lbl">Total</div>
            </div>
            <div class="order-stat">
                <div class="stat-num" style="color: #28a745;">@Model.Orders.Count(o => o.Status == "confirmed" || o.Status == "delivered")</div>
                <div class="stat-lbl">Completed</div>
            </div>
            <div class="order-stat">
                <div class="stat-num" style="color: #ffc107;">@Model.Orders.Count(o => o.Status == "pending" || o.Status == "pending_payment")</div>
                <div class="stat-lbl">Pending</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Orders.Any())
{
    <div class="empty-state">
        <i class="bi bi-bag display-1" style="color: #ffcdb2;"></i>
        <h5 class="mt-3">No Orders Yet</h5>
        <p>Check out today's <a asp-page="/Menu/Index" class="text-decoration-none fw-semibold" style="color: #ff6b35;">menu</a> to place your first order!</p>
    </div>
}
else
{
    <div class="card-modern">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Order Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders.OrderByDescending(o => o.OrderDate))
                    {
                        <tr data-order-id="@order.Id">
                            <td>
                                <div class="fw-semibold">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                <div class="text-muted small">@order.OrderDate.ToString("HH:mm")</div>
                            </td>
                            <td><span class="badge badge-soft-muted">@order.OrderDetails.Count item(s)</span></td>
                            <td class="fw-bold" style="color: #ff6b35;">@order.TotalAmount.ToString("N0") ₫</td>
                            <td>
                                <span class="badge @(order.Status switch
                                {
                                    "confirmed" or "delivered" => "badge-soft-success",
                                    "pending" or "pending_payment" => "badge-soft-warning",
                                    "payment_failed" or "cancelled" => "badge-soft-danger",
                                    _ => "badge-soft-muted"
                                })" data-order-status-badge>@order.Status</span>
                            </td>
                            <td>
                                <a asp-page="/Orders/Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Live status updates on the order list page
        document.addEventListener("orderStatusUpdated", (e) => {
            const row = document.querySelector(`tr[data-order-id="${e.detail.orderId}"]`);
            if (!row) return;
            const badge = row.querySelector("[data-order-status-badge]");
            if (!badge) return;
            const s = e.detail.newStatus.toLowerCase();
            badge.textContent = e.detail.newStatus;
            badge.className = "badge " + (
                s === "confirmed" || s === "delivered" ? "badge-soft-success" :
                s === "pending" || s === "pending_payment" ? "badge-soft-warning" :
                s === "payment_failed" || s === "cancelled" ? "badge-soft-danger" :
                "badge-soft-muted"
            );
        });
    </script>
}
