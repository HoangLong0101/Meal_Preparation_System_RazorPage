@page
@model Meal_Preparation_System_RazorPage.Pages.Fridge.SmartMealsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Smart Meals";
}

<a asp-page="/Fridge/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Inventory</a>

<div class="page-header">
    <h2><i class="bi bi-lightbulb me-2" style="color: var(--clr-warning);"></i>Smart Meals from Inventory</h2>
    <p class="mb-0">AI suggests meals based on what you already have — and tells you what's missing</p>
</div>

@if (ViewContext.HttpContext.Session.GetString("ShoppingList") is string shoppingListJson)
{
    var shoppingItems = System.Text.Json.JsonSerializer.Deserialize<List<MealPrepService.BusinessLogicLayer.Interfaces.ShoppingListItem>>(shoppingListJson);
    if (shoppingItems != null && shoppingItems.Any())
    {
        <div class="card-modern p-4 mb-4" style="border-left: 4px solid var(--clr-warning);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-cart-plus me-2" style="color: var(--clr-warning);"></i>Shopping List</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge badge-soft-warning">@shoppingItems.Count item(s) needed</span>
                    <a asp-page="/Fridge/Index" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-box-seam me-1"></i>View in Inventory
                    </a>
                </div>
            </div>
            <p class="text-muted small mb-2">Missing ingredients for the meal you added. View full list in your <a asp-page="/Fridge/Index">Inventory</a>.</p>
        </div>
    }
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card-modern p-4 mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-sliders me-2" style="color: var(--clr-primary);"></i>Preferences</h5>

            <form method="post" data-ai-loading="Finding the best meals from your inventory">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Meal Type</label>
                    <select asp-for="MealType" class="form-select form-control-modern">
                        <option value="Breakfast">🌅 Breakfast</option>
                        <option value="Lunch" selected>☀️ Lunch</option>
                        <option value="Dinner">🌙 Dinner</option>
                        <option value="Snack">🍿 Snack</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold"><i class="bi bi-chat-dots me-1"></i>What do you feel like eating?</label>
                    <textarea asp-for="MealPreference" class="form-control form-control-modern" rows="3"
                              placeholder="e.g. Something warm and spicy, a light salad, a high-protein stir fry..."></textarea>
                    <small class="text-muted">Describe what you're in the mood for</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Max Prep Time</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-clock"></i></span>
                        <input asp-for="MaxPrepTime" class="form-control" type="number" min="5" max="180" placeholder="No limit" />
                        <span class="input-group-text">minutes</span>
                    </div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input asp-for="PrioritizeExpiring" class="form-check-input" type="checkbox" role="switch" checked />
                    <label class="form-check-label fw-semibold" asp-for="PrioritizeExpiring">
                        <i class="bi bi-exclamation-triangle me-1" style="color: var(--clr-warning);"></i>Prioritize expiring ingredients
                    </label>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold"><i class="bi bi-people me-1"></i>Cooking For</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <select asp-for="Servings" class="form-select form-control-modern">
                            @for (int i = 1; i <= Model.MaxFamilySize; i++)
                            {
                                <option value="@i">@i @(i == 1 ? "person" : "people")</option>
                            }
                        </select>
                    </div>
                    @if (Model.FamilyMembers.Any())
                    {
                        <small class="text-muted">
                            Family: You + @string.Join(", ", Model.FamilyMembers.Select(m => m.Name))
                        </small>
                    }
                </div>

                <button type="submit" class="btn btn-primary-custom w-100" style="background: var(--clr-warning); color: #1e293b;"
                        @(Model.FridgeItems.Any() ? "" : "disabled")>
                    <i class="bi bi-stars me-1"></i> Generate Smart Meals
                </button>
            </form>
        </div>

        <div class="card-modern p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-box-seam me-2" style="color: var(--clr-success);"></i>Your Inventory</h5>
            @if (!Model.FridgeItems.Any())
            {
                <p class="text-muted small mb-0">Your inventory is empty. <a asp-page="/Fridge/Index">Add ingredients</a> first.</p>
            }
            else
            {
                @if (Model.ExpiringItems.Any())
                {
                    <div class="mb-3 p-2 rounded-3" style="background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2);">
                        <small class="fw-semibold" style="color: #b45309;"><i class="bi bi-exclamation-triangle me-1"></i>Expiring Soon:</small>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var item in Model.ExpiringItems)
                            {
                                <span class="badge badge-soft-warning">@item.IngredientName</span>
                            }
                        </div>
                    </div>
                }
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var item in Model.FridgeItems)
                    {
                        <span class="ingredient-tag @(item.IsExpiring ? "border-warning" : "") @(item.IsExpired ? "border-danger" : "")">
                            @item.IngredientName
                            <span class="text-muted">(@item.CurrentAmount @item.Unit)</span>
                        </span>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-lg-7">
        @if (!Model.HasGenerated)
        {
            <div class="empty-state">
                <i class="bi bi-lightbulb display-1 text-muted"></i>
                <h5 class="mt-3">Ready to Cook Something?</h5>
                <p>Set your preferences and let AI suggest meals from your inventory.</p>
            </div>
        }
        else if (Model.SuggestionResult != null && Model.SuggestionResult.Suggestions.Any())
        {
            @if (Model.SuggestionResult.UsedExpiringIngredients.Any())
            {
                <div class="card-modern p-3 mb-3" style="border-left: 4px solid var(--clr-warning);">
                    <small class="fw-semibold"><i class="bi bi-exclamation-triangle me-1" style="color: var(--clr-warning);"></i>Using expiring ingredients:</small>
                    <span class="text-muted small">@string.Join(", ", Model.SuggestionResult.UsedExpiringIngredients)</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.SuggestionResult.Reasoning))
            {
                <div class="card-modern p-3 mb-3">
                    <small class="fw-semibold"><i class="bi bi-robot me-1" style="color: var(--clr-primary);"></i>AI Reasoning:</small>
                    <p class="text-muted small mb-0 mt-1">@Model.SuggestionResult.Reasoning</p>
                </div>
            }

            <div class="d-flex flex-column gap-3">
                @foreach (var suggestion in Model.SuggestionResult.Suggestions)
                {
                    <div class="card-modern">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0">@suggestion.MealName</h5>
                                <div class="d-flex gap-1">
                                    <span class="badge badge-soft-primary">@Math.Round(suggestion.EstimatedCalories, 0) kcal</span>
                                    @if (suggestion.PrepTime > 0)
                                    {
                                        <span class="badge badge-soft-muted"><i class="bi bi-clock me-1"></i>@suggestion.PrepTime min</span>
                                    }
                                </div>
                            </div>

                            <p class="text-muted small mb-3">@suggestion.Description</p>

                            <div class="d-flex gap-2 flex-wrap mb-3">
                                <span class="badge badge-soft-success">P: @Math.Round(suggestion.ProteinG, 1)g</span>
                                <span class="badge badge-soft-warning">C: @Math.Round(suggestion.CarbsG, 1)g</span>
                                <span class="badge badge-soft-danger">F: @Math.Round(suggestion.FatG, 1)g</span>
                                <span class="badge @(suggestion.InventoryMatchPercentage >= 80 ? "badge-soft-success" : suggestion.InventoryMatchPercentage >= 50 ? "badge-soft-warning" : "badge-soft-danger")">
                                    <i class="bi bi-box-seam me-1"></i>@suggestion.InventoryMatchPercentage% from inventory
                                </span>
                            </div>

                            @if (suggestion.IngredientsFromInventory.Any())
                            {
                                <div class="mb-2">
                                    <small class="fw-semibold text-success"><i class="bi bi-check-circle me-1"></i>From your inventory:</small>
                                    <div class="d-flex flex-wrap gap-1 mt-1">
                                        @foreach (var ing in suggestion.IngredientsFromInventory)
                                        {
                                            <span class="ingredient-tag @(ing.IsExpiringSoon ? "border-warning" : "")">
                                                @ing.Name (@ing.RequiredAmount @ing.Unit)
                                                @if (ing.IsExpiringSoon)
                                                {
                                                    <i class="bi bi-exclamation-triangle ms-1" style="color: var(--clr-warning); font-size: 0.7rem;"></i>
                                                }
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            @if (suggestion.MissingIngredients.Any())
                            {
                                <div class="p-2 rounded-3 mt-2" style="background: rgba(220,38,38,0.04); border: 1px solid rgba(220,38,38,0.15);">
                                    <small class="fw-semibold" style="color: var(--clr-danger);"><i class="bi bi-cart-plus me-1"></i>Shopping list:</small>
                                    <div class="mt-1">
                                        @foreach (var missing in suggestion.MissingIngredients)
                                        {
                                            <div class="d-flex justify-content-between align-items-center py-1 small">
                                                <span>
                                                    @missing.IngredientName
                                                    @if (missing.IsEssential)
                                                    {
                                                        <span class="badge badge-soft-danger" style="font-size: 0.65rem;">Required</span>
                                                    }
                                                </span>
                                                <span class="text-muted">@missing.NeededAmount @missing.Unit</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(missing.SubstituteNote))
                                            {
                                                <small class="text-muted fst-italic d-block ps-2" style="font-size: 0.75rem;">💡 @missing.SubstituteNote</small>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(suggestion.Reasoning))
                            {
                                <div class="mt-2 pt-2" style="border-top: 1px solid var(--clr-border);">
                                    <small class="text-muted fst-italic"><i class="bi bi-chat-left-text me-1"></i>@suggestion.Reasoning</small>
                                </div>
                            }
                        </div>

                        @{
                            var suggestionIndex = Model.SuggestionResult.Suggestions.IndexOf(suggestion);
                            var addCollapseId = $"add-plan-{suggestionIndex}";
                        }
                        <div class="card-footer">
                            <div class="d-flex gap-2 mb-0">
                                @if (suggestion.RecipeId.HasValue)
                                {
                                    <a asp-page="/Recipes/Details" asp-route-id="@suggestion.RecipeId" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye me-1"></i>View Full Recipe
                                    </a>
                                }
                                @if (Model.UserMealPlans.Any())
                                {
                                    <button class="btn btn-outline-success btn-sm" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@addCollapseId">
                                        <i class="bi bi-plus-lg me-1"></i>Add to Meal Plan
                                    </button>
                                }
                                else
                                {
                                    <a asp-page="/MealPlans/Generate" class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-plus-lg me-1"></i>Create a Plan First
                                    </a>
                                }
                            </div>
                            @if (Model.UserMealPlans.Any())
                            {
                                <div class="collapse mt-3" id="@addCollapseId">
                                    @if (suggestion.RecipeId.HasValue)
                                    {
                                        <form method="post" asp-page-handler="AddToPlan">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="recipeId" value="@suggestion.RecipeId" />
                                            <input type="hidden" name="missingIngredientsJson" value="@System.Text.Json.JsonSerializer.Serialize(suggestion.MissingIngredients)" />
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Plan</label>
                                                    <select name="planId" class="form-select form-select-sm" required>
                                                        @foreach (var plan in Model.UserMealPlans)
                                                        {
                                                            <option value="@plan.Id">@plan.PlanName @(plan.IsActive ? "★" : "")</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold">Date</label>
                                                    <input type="date" name="serveDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold">Meal</label>
                                                    <select name="mealType" class="form-select form-select-sm" required>
                                                        <option value="breakfast">🌅 Breakfast</option>
                                                        <option value="lunch" selected>☀️ Lunch</option>
                                                        <option value="dinner">🌙 Dinner</option>
                                                        <option value="snack">🍿 Snack</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                                        <i class="bi bi-check-lg"></i> Add
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="SaveAndAddToPlan">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="recipeName" value="@suggestion.MealName" />
                                            <input type="hidden" name="instructions" value="@suggestion.Instructions" />
                                            <input type="hidden" name="calories" value="@suggestion.EstimatedCalories" />
                                            <input type="hidden" name="protein" value="@suggestion.ProteinG" />
                                            <input type="hidden" name="carbs" value="@suggestion.CarbsG" />
                                            <input type="hidden" name="fat" value="@suggestion.FatG" />
                                            <input type="hidden" name="missingIngredientsJson" value="@System.Text.Json.JsonSerializer.Serialize(suggestion.MissingIngredients)" />
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-4">
                                                    <label class="form-label small fw-semibold">Plan</label>
                                                    <select name="planId" class="form-select form-select-sm" required>
                                                        @foreach (var plan in Model.UserMealPlans)
                                                        {
                                                            <option value="@plan.Id">@plan.PlanName @(plan.IsActive ? "★" : "")</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold">Date</label>
                                                    <input type="date" name="serveDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small fw-semibold">Meal</label>
                                                    <select name="mealType" class="form-select form-select-sm" required>
                                                        <option value="breakfast">🌅 Breakfast</option>
                                                        <option value="lunch" selected>☀️ Lunch</option>
                                                        <option value="dinner">🌙 Dinner</option>
                                                        <option value="snack">🍿 Snack</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-2">
                                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                                        <i class="bi bi-check-lg"></i> Add
                                                    </button>
                                                </div>
                                            </div>
                                            <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i>This will save the AI recipe to your library first</small>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (Model.HasGenerated)
        {
            <div class="empty-state">
                <i class="bi bi-emoji-frown display-1 text-muted"></i>
                <h5 class="mt-3">No Suggestions Found</h5>
                <p>AI couldn't find suitable meals with your current inventory. Try adding more ingredients or adjusting preferences.</p>
            </div>
        }
    </div>
</div>
