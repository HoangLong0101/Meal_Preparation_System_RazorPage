@page
@model Meal_Preparation_System_RazorPage.Pages.Fridge.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Inventory";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="bi bi-box-seam me-2" style="color: var(--clr-primary);"></i>My Inventory</h2>
            <p class="mb-0">Track your ingredients and expiry dates</p>
        </div>
        <a asp-page="/Fridge/SmartMeals" class="btn btn-primary-custom" style="background: var(--clr-warning); color: #1e293b;">
            <i class="bi bi-lightbulb me-1"></i> Smart Meals
        </a>
    </div>
</div>

@if (ViewContext.HttpContext.Session.GetString("ShoppingList") is string shoppingListJson)
{
    var shoppingItems = System.Text.Json.JsonSerializer.Deserialize<List<MealPrepService.BusinessLogicLayer.Interfaces.ShoppingListItem>>(shoppingListJson);
    if (shoppingItems != null && shoppingItems.Any())
    {
        <div class="card-modern p-4 mb-4" style="border-left: 4px solid var(--clr-warning);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-cart-plus me-2" style="color: var(--clr-warning);"></i>Shopping List</h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge badge-soft-warning">@shoppingItems.Count item(s) needed</span>
                    <form method="post" asp-page-handler="ConfirmShoppingList"
                          data-confirm='{"title":"Confirm Purchase?","message":"These ingredients will be added to your inventory with a 7-day expiry. Continue?","icon":"bi-cart-check","confirmText":"Confirm"}'>
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm" title="Confirm purchase and add to inventory">
                            <i class="bi bi-cart-check me-1"></i>Confirm Purchase
                        </button>
                    </form>
                </div>
            </div>
            <p class="text-muted small mb-2">These ingredients are missing from your inventory for a meal you added:</p>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th class="small fw-semibold">Ingredient</th>
                            <th class="small fw-semibold">Amount</th>
                            <th class="small fw-semibold">Priority</th>
                            <th class="small fw-semibold">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in shoppingItems)
                        {
                            <tr>
                                <td class="fw-semibold">@item.IngredientName</td>
                                <td>@item.NeededAmount @item.Unit</td>
                                <td>
                                    @if (item.IsEssential)
                                    {
                                        <span class="badge badge-soft-danger">Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-muted">Optional</span>
                                    }
                                </td>
                                <td class="small text-muted fst-italic">@(item.SubstituteNote ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<div class="row g-4">
    <div class="col-lg-8">
        @if (Model.ExpiringItems.Any())
        {
            <div class="card-modern mb-4 expiry-warning">
                <div class="card-body">
                    <h5 class="fw-bold mb-3"><i class="bi bi-exclamation-triangle me-2" style="color: var(--clr-warning);"></i>Expiring Soon</h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var item in Model.ExpiringItems)
                        {
                            <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 @(item.IsExpired ? "expiry-danger" : "")"
                                 style="background: var(--clr-bg); border: 1px solid var(--clr-border);">
                                <span class="fw-semibold">@item.IngredientName</span>
                                <span class="badge @(item.IsExpired ? "badge-soft-danger" : "badge-soft-warning")">
                                    @(item.IsExpired ? "Expired" : item.ExpiryDate.ToString("MMM dd"))
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!Model.FridgeItems.Any())
        {
            <div class="empty-state">
                <i class="bi bi-box-seam display-1 text-muted"></i>
                <h5 class="mt-3">Your Inventory is Empty</h5>
                <p>Add ingredients to start tracking what you have.</p>
            </div>
        }
        else
        {
            <div class="card-modern">
                <div class="table-responsive">
                    <table class="table table-modern mb-0">
                        <thead>
                            <tr>
                                <th>Ingredient</th>
                                <th>Amount</th>
                                <th>Expiry Date</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.FridgeItems)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <i class="bi bi-egg me-1" style="color: var(--clr-primary);"></i>
                                        @item.IngredientName
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="UpdateQuantity" class="d-flex align-items-center gap-2" style="max-width: 180px;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <input type="number" name="newQuantity" value="@item.CurrentAmount" step="0.1" min="0"
                                                   class="form-control form-control-sm form-control-modern" style="width: 80px;" />
                                            <span class="text-muted small">@item.Unit</span>
                                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td>@item.ExpiryDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (item.IsExpired)
                                        {
                                            <span class="badge badge-soft-danger"><i class="bi bi-x-circle me-1"></i>Expired</span>
                                        }
                                        else if (item.IsExpiring)
                                        {
                                            <span class="badge badge-soft-warning"><i class="bi bi-exclamation-triangle me-1"></i>Expiring</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-success"><i class="bi bi-check-circle me-1"></i>Fresh</span>
                                        }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="Remove" data-confirm='{"title":"Remove Item?","message":"This item will be removed from your inventory.","icon":"bi-trash","confirmText":"Remove"}'>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card-modern p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2" style="color: var(--clr-success);"></i>Add Item</h5>

            <form method="post" asp-page-handler="Add">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Ingredient</label>
                    <select asp-for="NewItem.IngredientId" class="form-select form-control-modern">
                        <option value="">Select ingredient...</option>
                        @foreach (var ing in Model.AvailableIngredients)
                        {
                            <option value="@ing.Id">@ing.IngredientName (@ing.Unit)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Amount</label>
                    <input asp-for="NewItem.CurrentAmount" class="form-control form-control-modern" type="number" step="0.1" min="0.1" required />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Expiry Date</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                        <input asp-for="NewItem.ExpiryDate" class="form-control" type="date" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100" style="background: var(--clr-success);">
                    <i class="bi bi-plus-lg me-1"></i> Add to Inventory
                </button>
            </form>
        </div>
    </div>
</div>
