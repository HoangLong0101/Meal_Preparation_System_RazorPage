@page
@model Meal_Preparation_System_RazorPage.Pages.MealPlans.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Meal Plans";
}

<style>
    .plans-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 40px 0;
        margin: -24px -12px 30px -12px;
        border-radius: 0 0 24px 24px;
    }
    .plan-card {
        background: white;
        border: 1px solid #f0f0f0;
        border-radius: 16px;
        transition: all 0.3s ease;
        overflow: hidden;
    }
    .plan-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    .plan-card.active-plan {
        border-left: 4px solid #ff6b35;
    }
    .plan-card .card-body { padding: 24px; }
    .plan-card .card-footer {
        background: #fafafa;
        border-top: 1px solid #f0f0f0;
        padding: 16px 24px;
    }
    .btn-generate {
        background: linear-gradient(135deg, #ff6b35, #ff8c5a);
        border: none;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-generate:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);
        color: white;
    }
</style>

<div class="plans-header">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 style="font-size: 2rem; font-weight: 700;"><i class="bi bi-calendar-week me-2" style="color: #ff6b35;"></i>My Meal Plans</h1>
                <p style="color: #888;">AI-powered meal plans tailored to your profile</p>
            </div>
            <a asp-page="/MealPlans/Generate" class="btn-generate">
                <i class="bi bi-stars me-1"></i> Generate AI Plan
            </a>
        </div>
    </div>
</div>

@if (!Model.MealPlans.Any())
{
    <div class="empty-state">
        <i class="bi bi-clipboard display-1" style="color: #ccc;"></i>
        <h5 class="mt-3">No Meal Plans Yet</h5>
        <p>Let AI create a personalized meal plan for you.</p>
        <a asp-page="/MealPlans/Generate" class="btn-generate mt-2">
            <i class="bi bi-stars me-1"></i> Generate Your First Plan
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var plan in Model.MealPlans)
        {
            <div class="col-md-6">
                <div class="plan-card h-100 @(plan.IsActive ? "active-plan" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0">@plan.PlanName</h5>
                            <div class="d-flex gap-1">
                                @if (plan.IsActive)
                                {
                                    <span class="badge badge-soft-primary">Active</span>
                                }
                                @if (plan.IsAiGenerated)
                                {
                                    <span class="badge badge-soft-success"><i class="bi bi-stars me-1"></i>AI</span>
                                }
                            </div>
                        </div>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-calendar-range me-1"></i>
                            @plan.StartDate.ToString("MMM dd") — @plan.EndDate.ToString("MMM dd, yyyy")
                        </p>
                        <p class="small mb-0">
                            <i class="bi bi-cup-hot me-1"></i> @plan.Meals.Count meals planned
                        </p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-page="/MealPlans/Details" asp-route-id="@plan.Id" class="btn btn-sm" style="background: #fff5f0; color: #ff6b35; border: 1px solid #ff6b35;">
                            <i class="bi bi-eye me-1"></i>View
                        </a>
                        @if (!plan.IsActive)
                        {
                            <form method="post" asp-page-handler="SetActive">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="planId" value="@plan.Id" />
                                <button type="submit" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Set Active
                                </button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this meal plan?');" class="ms-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="planId" value="@plan.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
