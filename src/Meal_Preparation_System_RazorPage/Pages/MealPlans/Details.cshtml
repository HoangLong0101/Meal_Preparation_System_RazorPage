@page "{id}"
@model Meal_Preparation_System_RazorPage.Pages.MealPlans.DetailsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Plan.PlanName;
}

<style>
    .detail-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 32px 0;
        margin: -24px -12px 30px -12px;
        border-radius: 0 0 24px 24px;
    }
    .day-card {
        background: white;
        border: 1px solid #f0f0f0;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 20px;
    }
    .day-card-header {
        background: #fafafa;
        border-bottom: 1px solid #f0f0f0;
        padding: 16px 24px;
    }
    .meal-item {
        background: #fafafa;
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
    }
    .meal-item.finished {
        opacity: 0.6;
    }
</style>

<div class="detail-header">
    <div class="container">
        <a asp-page="/MealPlans/Index" class="btn-back" style="color: #888;"><i class="bi bi-arrow-left"></i> Back to Meal Plans</a>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 style="font-size: 2rem; font-weight: 700;">@Model.Plan.PlanName</h1>
                <p style="color: #888;">
                    <i class="bi bi-calendar-range me-1"></i>
                    @Model.Plan.StartDate.ToString("MMM dd") — @Model.Plan.EndDate.ToString("MMM dd, yyyy")
                </p>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Plan.IsActive)
                {
                    <span class="badge badge-soft-primary fs-6 px-3 py-2">Active Plan</span>
                }
                @if (Model.Plan.IsAiGenerated)
                {
                    <span class="badge badge-soft-success fs-6 px-3 py-2"><i class="bi bi-stars me-1"></i>AI Generated</span>
                }
            </div>
        </div>
    </div>
</div>

@if (!Model.Plan.Meals.Any())
{
    <div class="empty-state">
        <i class="bi bi-cup-hot display-1 text-muted"></i>
        <h5 class="mt-3">No Meals in This Plan</h5>
        <p>This plan doesn't have any meals yet.</p>
    </div>
}
else
{
    @foreach (var dateGroup in Model.Plan.Meals.GroupBy(m => m.ServeDate.Date).OrderBy(g => g.Key))
    {
        <div class="day-card">
            <div class="day-card-header">
                <strong><i class="bi bi-calendar-day me-2" style="color: #ff6b35;"></i>@dateGroup.Key.ToString("dddd, MMM dd yyyy")</strong>
            </div>
            <div class="p-4">
                @foreach (var meal in dateGroup.OrderBy(m => m.MealType))
                {
                    <div class="meal-item @(meal.MealFinished ? "finished" : "")">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 fw-bold">
                                @switch (meal.MealType.ToLower())
                                {
                                    case "breakfast":
                                        <i class="bi bi-sunrise me-1" style="color: #f59e0b;"></i>
                                        break;
                                    case "lunch":
                                        <i class="bi bi-sun me-1" style="color: #ff6b35;"></i>
                                        break;
                                    case "dinner":
                                        <i class="bi bi-moon me-1" style="color: #888;"></i>
                                        break;
                                }
                                @meal.MealType.ToUpper()
                                @if (meal.MealFinished)
                                {
                                    <span class="badge badge-soft-success ms-2"><i class="bi bi-check-lg me-1"></i>Done</span>
                                }
                            </h6>
                            <form method="post" asp-page-handler="ToggleMealFinished">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="mealId" value="@meal.Id" />
                                <input type="hidden" name="finished" value="@(!meal.MealFinished)" />
                                <button type="submit" class="btn btn-sm @(meal.MealFinished ? "btn-outline-secondary" : "btn-outline-success")">
                                    <i class="bi @(meal.MealFinished ? "bi-arrow-counterclockwise" : "bi-check-lg") me-1"></i>
                                    @(meal.MealFinished ? "Undo" : "Mark Done")
                                </button>
                            </form>
                        </div>
                        @if (meal.Recipes.Any())
                        {
                            <ul class="list-unstyled mt-3 mb-0">
                                @foreach (var recipe in meal.Recipes)
                                {
                                    <li class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid #f0f0f0;">
                                        <a asp-page="/Recipes/Details" asp-route-id="@recipe.Id" class="text-decoration-none fw-semibold" style="color: #ff6b35;">
                                            <i class="bi bi-book me-1"></i>@recipe.RecipeName
                                        </a>
                                        <span class="badge badge-soft-primary">@Math.Round(recipe.TotalCalories, 0) kcal</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    }
}
