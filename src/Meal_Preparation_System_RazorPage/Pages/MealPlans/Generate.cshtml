@page
@model Meal_Preparation_System_RazorPage.Pages.MealPlans.GenerateModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Generate Meal Plan";
}

<style>
    .generate-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
    }
    .generate-header {
        background: linear-gradient(135deg, #43a047, #66bb6a);
        padding: 40px 32px;
        text-align: center;
        color: white;
    }
    .generate-header i {
        font-size: 48px;
        margin-bottom: 12px;
        display: block;
    }
    .generate-body {
        padding: 32px;
    }
    .btn-gen {
        background: linear-gradient(135deg, #43a047, #66bb6a);
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-gen:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(67, 160, 71, 0.3);
        color: white;
    }
    .input-group-gen .input-group-text {
        background: #e8f5e9;
        border: 2px solid #f0f0f0;
        border-right: none;
        color: #43a047;
    }
    .input-group-gen .form-control {
        border: 2px solid #f0f0f0;
        border-left: none;
        padding: 12px 16px;
    }
    .input-group-gen .form-control:focus {
        border-color: #43a047;
        box-shadow: none;
    }
    .input-group-gen:focus-within .input-group-text {
        border-color: #43a047;
    }
</style>

<a asp-page="/MealPlans/Index" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Meal Plans</a>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="generate-card">
            <div class="generate-header">
                <i class="bi bi-stars"></i>
                <h3 style="font-weight: 700; margin-bottom: 4px;">Generate AI Meal Plan</h3>
                <p style="opacity: 0.9; font-size: 14px; margin: 0;">
                    AI will create a personalized meal plan based on your health profile, allergies, and preferences.
                </p>
            </div>
            <div class="generate-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Plan Name <span class="text-muted fw-normal">(optional)</span></label>
                        <div class="input-group input-group-gen">
                            <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                            <input asp-for="PlanName" class="form-control" placeholder="e.g. Week 1 Healthy Plan" />
                        </div>
                    </div>

                    <div class="row mb-4 g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Start Date</label>
                            <div class="input-group input-group-gen">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="StartDate" class="form-control" type="date" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">End Date</label>
                            <div class="input-group input-group-gen">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="EndDate" class="form-control" type="date" required />
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-gen w-100">
                        <i class="bi bi-stars me-1"></i> Generate Meal Plan
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
