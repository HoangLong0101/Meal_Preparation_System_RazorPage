<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MealPrep</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Meal_Preparation_System_RazorPage.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="bi bi-egg-fried me-1"></i> MealPrep
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index"><i class="bi bi-house-door me-1"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Menu/Index"><i class="bi bi-calendar3 me-1"></i>Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Recipes/Index"><i class="bi bi-book me-1"></i>Recipes</a>
                        </li>
                        @if (Context.Session.GetString("AccountId") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/MealPlans/Index"><i class="bi bi-clipboard-check me-1"></i>Meal Plans</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Orders/Index"><i class="bi bi-bag me-1"></i>Orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Fridge/Index"><i class="bi bi-box-seam me-1"></i>Inventory</a>
                            </li>
                        }
                        @if (Context.Session.GetString("Role") is "Admin" or "Manager")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1"></i>Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Admin/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/MenuManagement"><i class="bi bi-calendar3 me-2"></i>Menu Management</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Orders"><i class="bi bi-bag-check me-2"></i>All Orders</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Accounts"><i class="bi bi-people me-2"></i>Staff Accounts</a></li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Nutrition/Calculator"><i class="bi bi-calculator me-1"></i>Nutrition</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("AccountId") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link navbar-user-greeting"><i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("FullName")</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Account/Profile"><i class="bi bi-person-gear me-1"></i>Profile</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Account/Logout"><i class="bi bi-box-arrow-right me-1"></i>Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Account/Register"><i class="bi bi-person-plus me-1"></i>Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3 mt-4">
            @{
                var toastSuccess = TempData["SuccessMessage"]?.ToString();
                var toastError = TempData["ErrorMessage"]?.ToString();
            }
            @if (!string.IsNullOrEmpty(toastSuccess) || !string.IsNullOrEmpty(toastError))
            {
                <div id="toast-data" data-success="@toastSuccess" data-error="@toastError"></div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer-modern mt-5">
        <div class="container text-center">
            &copy; 2026 MealPrep &mdash; <a asp-area="" asp-page="/Privacy" class="text-decoration-none">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (Context.Session.GetString("AccountId") is string signalRAccountId)
    {
        var signalRRole = Context.Session.GetString("Role") ?? "";
        <script>
            const mealPrepConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/mealprepHub")
                .withAutomaticReconnect()
                .build();

            // --- Menu: live quantity + sold-out updates ---
            mealPrepConnection.on("MenuMealQuantityChanged", (mealName, newQty, isSoldOut) => {
                if (isSoldOut)
                    MealPrepToast.error(`🚫 "${mealName}" is now sold out!`);
                else
                    MealPrepToast.info(`📦 "${mealName}": ${newQty} left`);

                document.dispatchEvent(new CustomEvent("menuMealQuantityChanged", {
                    detail: { mealName, newQty, isSoldOut }
                }));
            });

            // --- Menu: structural changes (publish / add meal / deactivate) ---
            mealPrepConnection.on("MenuUpdated", (updateType, mealName, detail) => {
                let msg, type;
                if (updateType === "Published") { msg = "🍽️ New menu published!"; type = "success"; }
                else if (updateType === "MealAdded") { msg = `🆕 "${mealName}" added to the menu.`; type = "info"; }
                else if (updateType === "Deactivated") { msg = "🍽️ A menu has been deactivated."; type = "info"; }
                else if (updateType === "Reactivated") { msg = "🍽️ A menu has been reactivated!"; type = "success"; }
                else { msg = "🍽️ Menu has been updated."; type = "info"; }

                // Save toast for after reload so it doesn't disappear instantly
                sessionStorage.setItem("pendingToast", JSON.stringify({ message: msg, type }));

                document.dispatchEvent(new CustomEvent("menuStructureChanged", {
                    detail: { updateType, mealName, detail }
                }));
            });

            // --- Order status (for customer) ---
            mealPrepConnection.on("OrderStatusUpdated", (orderId, newStatus) => {
                MealPrepToast.info(`Order status updated to: ${newStatus}`);
                document.dispatchEvent(new CustomEvent("orderStatusUpdated", {
                    detail: { orderId, newStatus }
                }));
            });

            // --- New order placed (for admin) ---
            mealPrepConnection.on("NewOrderPlaced", (orderId, date, total, status, itemCount) => {
                MealPrepToast.success(`🛒 New order received! ${total} ₫`);
                document.dispatchEvent(new CustomEvent("newOrderPlaced", {
                    detail: { orderId, date, total, status, itemCount }
                }));
            });

            mealPrepConnection.on("InventoryExpiryAlert", (ingredientName, daysLeft) => {
                if (daysLeft <= 0)
                    MealPrepToast.error(`⚠️ ${ingredientName} has expired!`);
                else
                    MealPrepToast.info(`🕐 ${ingredientName} expires in ${daysLeft} day(s)`);
            });

            mealPrepConnection.on("MealPlanUpdated", (planName, message) => {
                MealPrepToast.success(`📋 ${planName}: ${message}`);
            });

            mealPrepConnection.start()
                .then(() => {
                    mealPrepConnection.invoke("JoinUserGroup", "@signalRAccountId");
                    mealPrepConnection.invoke("JoinMenuGroup");
                    @if (signalRRole is "Admin" or "Manager")
                    {
                        <text>mealPrepConnection.invoke("JoinAdminGroup");</text>
                    }
                })
                .catch(err => console.error("SignalR connection error:", err));
        </script>
    }
    else
    {
        <script>
            const mealPrepConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/mealprepHub")
                .withAutomaticReconnect()
                .build();

            mealPrepConnection.on("MenuMealQuantityChanged", (mealName, newQty, isSoldOut) => {
                if (isSoldOut)
                    MealPrepToast.error(`🚫 "${mealName}" is now sold out!`);
                document.dispatchEvent(new CustomEvent("menuMealQuantityChanged", {
                    detail: { mealName, newQty, isSoldOut }
                }));
            });

            mealPrepConnection.on("MenuUpdated", (updateType, mealName, detail) => {
                let msg = "🍽️ Menu has been updated.", type = "info";
                if (updateType === "Published") { msg = "🍽️ New menu published!"; type = "success"; }
                else if (updateType === "Reactivated") { msg = "🍽️ A menu is available again!"; type = "success"; }

                sessionStorage.setItem("pendingToast", JSON.stringify({ message: msg, type }));

                document.dispatchEvent(new CustomEvent("menuStructureChanged", {
                    detail: { updateType, mealName, detail }
                }));
            });

            mealPrepConnection.start()
                .then(() => mealPrepConnection.invoke("JoinMenuGroup"))
                .catch(err => console.error("SignalR connection error:", err));
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
