@page
@model Meal_Preparation_System_RazorPage.Pages.Nutrition.CalculatorModel
@{
    Layout = "_Layout";
}

<style>
    .nutrition-header {
        background: linear-gradient(135deg, #fff5f0 0%, #ffe8dc 100%);
        padding: 40px 0;
        margin: -24px -12px 30px -12px;
        border-radius: 0 0 24px 24px;
    }

    .metric-card {
        border-radius: 16px;
        min-height: 84px;
        border: 1px solid #f0f0f0;
    }

    .metric-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: #ff6b35;
    }

    .metric-label {
        font-size: 0.85rem;
        color: #888;
    }

    .meal-rating {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }
    .rating-excellent { background: #e8f5e9; color: #2e7d32; }
    .rating-good { background: #e3f2fd; color: #1565c0; }
    .rating-average { background: #fff8e1; color: #f57f17; }
    .rating-below-average { background: #fff3e0; color: #e65100; }
    .rating-poor { background: #fce4ec; color: #c62828; }

    .suggestion-card {
        border: 1px solid #f0f0f0;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 10px;
        transition: box-shadow 0.2s;
    }
    .suggestion-card:hover {
        box-shadow: 0 2px 12px rgba(255,107,53,0.12);
    }
    .suggestion-ingredient {
        font-weight: 700;
        color: #333;
        font-size: 0.95rem;
    }
    .suggestion-amount {
        font-size: 0.82rem;
        color: #ff6b35;
        font-weight: 600;
    }
    .suggestion-reason {
        font-size: 0.82rem;
        color: #666;
        margin-top: 4px;
    }
    .category-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
    }
    .cat-protein { background: #fce4ec; color: #c62828; }
    .cat-vegetable { background: #e8f5e9; color: #2e7d32; }
    .cat-grain { background: #fff8e1; color: #f57f17; }
    .cat-fruit { background: #f3e5f5; color: #7b1fa2; }
    .cat-dairy { background: #e3f2fd; color: #1565c0; }
    .cat-healthy-fat { background: #fff3e0; color: #e65100; }
    .cat-fiber { background: #e0f2f1; color: #00695c; }
</style>

<div class="nutrition-header text-center mb-4">
    <div class="container">
        <h1 style="font-size: 2rem; font-weight: 700;"><i class="bi bi-calculator me-2" style="color: #ff6b35;"></i>Meal Nutrient Calculator</h1>
        <p style="color: #888;">
            Enter your ingredients and portions — our AI will analyze nutrients and give friendly suggestions.
        </p>

        <div class="row mt-4 gx-3 justify-content-center">
            <div class="col-6 col-sm-4 col-md-3">
                <div class="card metric-card p-3 shadow-sm text-center">
                    <div class="metric-label">Calories</div>
                    <div class="metric-value">
                        @(Model.IsCalculated? Math.Round(Model.TotalCalories, 0) + " kcal" : "—")
                    </div>
                </div>
            </div>

            <div class="col-6 col-sm-4 col-md-3">
                <div class="card metric-card p-3 shadow-sm text-center">
                    <div class="metric-label">Protein</div>
                    <div class="metric-value">
                        @(Model.IsCalculated? Math.Round(Model.TotalProteinG, 1) + " g" : "—")
                    </div>
                </div>
            </div>

            <div class="col-6 col-sm-4 col-md-3 mt-3 mt-sm-0">
                <div class="card metric-card p-3 shadow-sm text-center">
                    <div class="metric-label">Carbs</div>
                    <div class="metric-value">
                        @(Model.IsCalculated? Math.Round(Model.TotalCarbsG, 1) + " g" : "—")
                    </div>
                </div>
            </div>

            <div class="col-6 col-sm-4 col-md-3 mt-3 mt-md-0">
                <div class="card metric-card p-3 shadow-sm text-center">
                    <div class="metric-label">Fat</div>
                    <div class="metric-value">
                        @(Model.IsCalculated? Math.Round(Model.TotalFatG, 1) + " g" : "—")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card card-modern p-4">
                <h5 class="mb-3">Ingredients</h5>

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th style="width:60%">Ingredient</th>
                                    <th style="width:20%">Amount</th>
                                    <th style="width:15%">Unit</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="ingredients-table">
                                @for (int i = 0; i < Model.Ingredients.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input asp-for="Ingredients[@i].IngredientName"
                                                   class="form-control form-control-modern"
                                                   placeholder="e.g. chicken breast" />
                                        </td>
                                        <td>
                                            <input asp-for="Ingredients[@i].Amount"
                                                   class="form-control form-control-modern" />
                                        </td>
                                        <td>
                                            <input asp-for="Ingredients[@i].Unit"
                                                   class="form-control form-control-modern"
                                                   placeholder="g, ml, pcs" />
                                        </td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    onclick="removeIngredient(this)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="addIngredient()">
                            Add ingredient
                        </button>

                        <button id="analyze-btn"
                                type="submit"
                                class="btn btn-primary-custom ms-auto"
                                disabled>
                            Analyze nutrients
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card card-modern p-4">
                <h5 class="mb-3">Summary</h5>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                @if (Model.IsCalculated)
                {
                    @if (!string.IsNullOrEmpty(Model.MealRating))
                    {
                        var ratingClass = Model.MealRating.ToLower() switch
                        {
                            "excellent" => "rating-excellent",
                            "good" => "rating-good",
                            "average" => "rating-average",
                            "below average" => "rating-below-average",
                            _ => "rating-poor"
                        };
                        var ratingIcon = Model.MealRating.ToLower() switch
                        {
                            "excellent" => "bi-star-fill",
                            "good" => "bi-hand-thumbs-up-fill",
                            "average" => "bi-dash-circle",
                            "below average" => "bi-exclamation-triangle",
                            _ => "bi-x-circle"
                        };
                        <div class="mb-3 text-center">
                            <span class="meal-rating @ratingClass">
                                <i class="bi @ratingIcon"></i> @Model.MealRating Meal
                            </span>
                        </div>
                    }

                    <ul class="list-group mb-3">
                        @foreach (var r in Model.IngredientResults)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <div>
                                    <strong>@r.IngredientName</strong><br />
                                    <small>@r.Amount @r.Unit</small>
                                </div>
                                <div>
                                    @Math.Round(r.Calories, 0) kcal
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="p-3 bg-light" style="border-radius:8px; white-space:pre-wrap;">
                        @Model.Advice
                    </div>

                    @if (Model.Suggestions.Any())
                    {
                        <hr />
                        <h6 class="mb-3" style="font-weight: 700;">
                            <i class="bi bi-lightbulb-fill me-1" style="color: #ff6b35;"></i>
                            Add These to Complete Your Meal
                        </h6>
                        @foreach (var s in Model.Suggestions)
                        {
                            var catClass = s.Category.ToLower().Replace(" ", "-") switch
                            {
                                "protein" => "cat-protein",
                                "vegetable" => "cat-vegetable",
                                "grain" => "cat-grain",
                                "fruit" => "cat-fruit",
                                "dairy" => "cat-dairy",
                                "healthy-fat" => "cat-healthy-fat",
                                "fiber" => "cat-fiber",
                                _ => "cat-vegetable"
                            };
                            <div class="suggestion-card">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="suggestion-ingredient">@s.Ingredient</span>
                                    <span class="suggestion-amount">@s.Amount</span>
                                </div>
                                <div>
                                    <span class="category-badge @catClass">@s.Category</span>
                                </div>
                                <div class="suggestion-reason">@s.Reason</div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="text-muted">
                        Enter ingredients and click Analyze nutrients.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function addIngredient() {
            var index = $('#ingredients-table tr').length;
            var row = `
            <tr>
                <td><input name="Ingredients[${index}].IngredientName" class="form-control form-control-modern" placeholder="e.g. chicken breast" /></td>
                <td><input name="Ingredients[${index}].Amount" class="form-control form-control-modern" /></td>
                <td><input name="Ingredients[${index}].Unit" class="form-control form-control-modern" placeholder="g, ml, pcs" /></td>
                <td><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeIngredient(this)"><i class="bi bi-trash"></i></button></td>
            </tr>`;
            $('#ingredients-table').append(row);
            updateAnalyzeButton();
        }

        function removeIngredient(btn) {
            $(btn).closest('tr').remove();
            // reindex names so model binding works
            $('#ingredients-table tr').each(function (i, tr) {
                $(tr).find('input').each(function () {
                    var name = $(this).attr('name');
                    if (name) {
                        var newName = name.replace(/Ingredients\[\d+\]/, 'Ingredients[' + i + ']');
                        $(this).attr('name', newName);
                    }
                });
            });
            updateAnalyzeButton();
        }

        function updateAnalyzeButton() {
            var enable = true;
            var rows = $('#ingredients-table tr');
            if (rows.length === 0) { enable = false; }
            rows.each(function () {
                var name = $(this).find('input[name$=".IngredientName"]').val();
                var amount = $(this).find('input[name$=".Amount"]').val();
                var unit = $(this).find('input[name$=".Unit"]').val();

                if (!name || String(name).trim() === '') { enable = false; return; }
                var num = parseFloat(amount);
                if (isNaN(num) || num <= 0) { enable = false; return; }
                if (!unit || String(unit).trim() === '') { enable = false; return; }
            });
            $('#analyze-btn').prop('disabled', !enable);
        }

        // delegated input events to update button state
        $(document).on('input change', '#ingredients-table input', function () {
            updateAnalyzeButton();
        });

        // initial check on page load
        $(function () { updateAnalyzeButton(); });
    </script>
}
